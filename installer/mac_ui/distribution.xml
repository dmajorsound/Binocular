<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Binocular – Correlation Meter</title>
    <organization>com.dmajorsound</organization>
    <background file="background.tiff" alignment="bottomleft" scaling="none"/>
    <background-darkAqua file="background-darkAqua.tiff" alignment="bottomleft" scaling="none"/>
    <welcome file="welcome.html" mime-type="text/html"/>
    <options customize="allow" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_localSystem="true"/>
    <choices-outline>
        <line choice="vst3"/>
        <line choice="au"/>
        <line choice="clap"/>
    </choices-outline>
    <choice id="vst3" title="VST3" description="For REAPER, Cubase, Nuendo, Ableton Live and most other DAWs.">
        <pkg-ref id="com.dmajorsound.binocular.vst3"/>
    </choice>
    <choice id="au" title="Audio Unit (AU)" description="For Logic Pro, GarageBand and other AU hosts.">
        <pkg-ref id="com.dmajorsound.binocular.au"/>
    </choice>
    <choice id="clap" title="CLAP" description="For REAPER, Bitwig Studio and other CLAP hosts.">
        <pkg-ref id="com.dmajorsound.binocular.clap"/>
    </choice>
    <pkg-ref id="com.dmajorsound.binocular.vst3" version="1.0.7" onConclusion="none">binocular-vst3.pkg</pkg-ref>
    <pkg-ref id="com.dmajorsound.binocular.au" version="1.0.7" onConclusion="none">binocular-au.pkg</pkg-ref>
    <pkg-ref id="com.dmajorsound.binocular.clap" version="1.0.7" onConclusion="none">binocular-clap.pkg</pkg-ref>
</installer-gui-script>
