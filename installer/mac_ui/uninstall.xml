<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Uninstall Binocular</title>
    <organization>com.dmajorsound</organization>
    <background file="background.tiff" alignment="bottomleft" scaling="none"/>
    <background-darkAqua file="background-darkAqua.tiff" alignment="bottomleft" scaling="none"/>
    <welcome file="uninstall.html" mime-type="text/html"/>
    <options customize="never" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_localSystem="true"/>
    <choices-outline>
        <line choice="default"/>
    </choices-outline>
    <choice id="default" title="Uninstall Binocular">
        <pkg-ref id="com.dmajorsound.binocular.uninstall"/>
    </choice>
    <pkg-ref id="com.dmajorsound.binocular.uninstall" version="1.2.0" onConclusion="none">binocular-uninstall-component.pkg</pkg-ref>
</installer-gui-script>
