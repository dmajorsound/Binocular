desc: Binocular
//author: dmajorsound
//tags: analysis meter correlation phase stereo mono
//version: 1.2.0
//about: Binocular - Mmm…etering! Multiband correlation meter, goniometer and loudness meter. Shows for every frequency band whether left and right
//  (or a track and its sidechain) are in phase, unrelated or out of phase.
//  All band counts: an FFT cross-spectrum (the old filter bank cost up to 3x the CPU).
//  Also shows how much each band loses in mono, and the time offset and polarity between the sides.
//  The audio passes through untouched, with no latency.

slider1:7<0,9,1{4,8,12,16,24,32,48,64,128,256}>-Bands
slider2:50<0,100,0.1>-Selectivity (%)
slider3:300<10,5000,1>-Averaging (ms)
slider4:0<0,1,1{Stereo,Sidechain}>-Input
slider5:1<0,2,1{Off,3 s,Infinite}>-Hold
slider6:0<0,1,1{Off,On}>-Freeze
slider7:0<0,1,1{Dark,Light}>-Theme
slider8:0<0,3,1{Correlation,Mono loss,Goniometer,Loudness}>-View
slider9:1<0,2,1{24 dB,48 dB,96 dB}>-Range
slider10:0<0,5,1{EBU R128,Netflix,Spotify,YouTube,Apple Music,Tidal}>-Loudness target
slider11:1<0,2,1{Always,Playback,Timecode}>-Measure
slider12:1<0,6,1{1 min,5 min,15 min,30 min,1 h,2 h,5 h}>-History span
// new sliders only at the end

in_pin:Left
in_pin:Right
in_pin:Sidechain Left
in_pin:Sidechain Right
out_pin:Left
out_pin:Right

@init
ext_noinit = 1;
gfx_ext_retina = 1;

tiny = 10^-24;
tiny12 = 10^-12;
dnz = 10^-18;          // alternating -360 dB offset, keeps the meter filters out of denormals (meter only, not the audio)

// memory
m_st  = 0;             // filter bank: 64 bands x 32 fields: 3 coefficients, 16 filter states, 3 averages
m_cor = 4096;          // correlation per band (up to 1024)
m_lev = 5120;          // level per band, dB
m_val = 6144;          // 1 = both sides carry signal
m_hld = 7168;          // lowest correlation held
m_ht  = 8192;          // time since that low
m_fc  = 9216;          // band centers, Hz
m_u0  = 10240;         // FFT bands: lower band edge, in bins of the engine the band uses
m_u1  = 11264;         // FFT bands: upper band edge
m_bl  = 12288;         // the band counts of the Bands control
m_rl  = 524288;        // input history left / main: a 65536 ring
m_rr  = 589824;        // input history right / sidechain
m_fb  = 131072;        // FFT buffer, complex, kept inside one 65536 block
m_win = 196608;        // Hann window, long FFT
m_sxx = 229376;        // long FFT: smoothed spectra per bin (up to 16384 bins each)
m_syy = 245776;
m_sxy = 262176;        // real part of the cross-spectrum
m_cxx = 278576;        // running sums over the bins
m_cyy = 294976;
m_cxy = 311376;
m_sxi = 327776;        // imaginary part of the cross-spectrum (for the offset)
m_wi2 = 344176;        // Hann window, short FFT
m_s2x = 352368;        // short FFT: spectra and running sums (up to 4096 bins each)
m_s2y = 360568;
m_s2c = 368768;
m_c2x = 376968;
m_c2y = 385168;
m_c2c = 393368;
m_eng = 401568;        // 1 = band is read from the short FFT
m_mon = 402592;        // mono loss per band, dB
m_hmo = 403616;        // deepest mono loss held
m_rfc = 404640;        // reference curve: correlation
m_rfm = 405664;        //                  mono loss
m_rfv = 406688;        //                  band carried signal
m_hmt = 407712;        // time since the deepest mono loss
m_gx  = 409600;        // goniometer: last 8192 samples, side (x) and mid (y)
m_gy  = 417792;
m_bl[0] = 4; m_bl[1] = 8; m_bl[2] = 12; m_bl[3] = 16; m_bl[4] = 24; m_bl[5] = 32;
m_bl[6] = 48; m_bl[7] = 64; m_bl[8] = 128; m_bl[9] = 256;

// ---------------------------------------------------------------- setup
// Log-spaced bands from 20 Hz to 20 kHz.
// All band counts read the FFT cross-spectrum. (The filter bank code below is kept but no longer used:
// two cascaded band-pass filters per band cost up to 3x the CPU of the FFT.) A band takes the short FFT (fast) when it is
// at least 3 of its bins wide, otherwise the long FFT (fine enough for the bass).
// The long FFT always runs: it also finds the offset and the polarity.
function setup() local(i, p, fc, w0, al, sp, wm, bw, xs, bo, e0, e1)
(
  nb = m_bl[max(0, min(9, floor(slider1+0.5)))];
  ffm = 1;
  fn = srate <= 50000 ? 16384 : 32768;   // long: 2.9 Hz per bin at 48 and 96 kHz
  fhop = fn/16;   // long spectrum ~47 times per second (smooth bars)
  fnb = fn/2;
  fs2 = fn/4;                            // short: 4096 at 48 kHz, about 85 ms
  fhop2 = fs2/8;  // short spectrum ~94 times per second
  fnb2 = fs2/2;
  flo = 20;
  fhi = min(20000, 0.45*srate);
  sp = log(fhi/flo)/log(2)/nb;           // band spacing in octaves
  wm = 2^(1 - 2*slider2/100);            // 0 % = twice the spacing, 50 % = the spacing, 100 % = half
  bw = sp*wm*1.6;                        // per stage; the cascade narrows it again
  bo = sp*wm;                            // FFT bands: width in octaves, 50 % = bands just touch
  memset(m_st, 0, 64*32);
  memset(m_rl, 0, 65536); memset(m_rr, 0, 65536);
  memset(m_sxx, 0, 16400*7);
  memset(m_s2x, 0, 8200*6);
  i = 0;
  loop(fn,
    m_win[i] = 0.5 - 0.5*cos(2*$pi*(i+0.5)/fn);
    i += 1;
  );
  i = 0;
  loop(fs2,
    m_wi2[i] = 0.5 - 0.5*cos(2*$pi*(i+0.5)/fs2);
    i += 1;
  );
  fwp = 0; fhc = 0; fhc2 = 0; fpend = 0; f2pend = 0; foffp = 0;
  i = 0;
  loop(nb,
    fc = flo*(fhi/flo)^((i+0.5)/nb);
    ffm ? (
      e0 = fc*2^(-bo/2); e1 = fc*2^(bo/2);
      m_eng[i] = (e1-e0)*fs2/srate >= 3;
      m_eng[i] ? (
        m_u0[i] = max(0.5, min(fnb2-1, e0*fs2/srate + 0.5));
        m_u1[i] = max(0.5, min(fnb2-1, e1*fs2/srate + 0.5));
      ) : (
        m_u0[i] = max(0.5, min(fnb-1, e0*fn/srate + 0.5));
        m_u1[i] = max(0.5, min(fnb-1, e1*fn/srate + 0.5));
      );
    ) : (
      m_eng[i] = 0;
      w0 = 2*$pi*fc/srate;
      xs = log(2)/2*bw*w0/sin(w0);
      al = sin(w0)*(exp(xs)-exp(-xs))/2;
      p = m_st + i*32;
      p[0] = al/(1+al);
      p[1] = -2*cos(w0)/(1+al);
      p[2] = (1-al)/(1+al);
    );
    m_fc[i] = fc;
    m_cor[i] = 0; m_lev[i] = -200; m_val[i] = 0; m_mon[i] = 0;
    m_hld[i] = 1; m_ht[i] = 0; m_hmo[i] = 0; m_hmt[i] = 0;
    i += 1;
  );
  bxy = bxx = byy = 0;
  bcor = 0; bval = 0; bhld = 1; bht = 0;
  ofs_ok = 0; ofs_lag = 0; ofs_sgn = 1;
  refon = 0;
  lnb = slider1; lsel = slider2; lsr = srate; lin = slider4;
);

// ---------------------------------------------------------------- FFT engine
// a running sum over the bins, read at a fractional bin position
function fsum(c, u, nbn) local(k)
(
  k = min(floor(u), nbn-1);
  c[k] + (u-k)*(c[k+1]-c[k]);
);

// one band from band powers: correlation, level, mono loss
function fband(i, xx, yy, xy) local(dd)
(
  dd = sqrt(xx*yy);
  m_cor[i] = dd > tiny ? max(-1, min(1, xy/dd)) : 0;
  m_lev[i] = 10*log10(0.5*(xx+yy) + tiny);
  m_val[i] = (10*log10(xx+tiny) > -100) || (10*log10(yy+tiny) > -100);   // one side silent: correlation 0, still shown
  m_mon[i] = 10*log10(max(tiny12, (xx+yy+2*xy)/(2*(xx+yy)+tiny)));
);

// left in the real part, right in the imaginary part of one FFT; split, then smooth per bin.
// sx, sy, sc: smoothed powers and real cross part. ci: imaginary cross part (0 = not needed).
function fspec(n, st, win, sx, sy, sc, ci, kf) local(i, j, k, a, b, c, d, xr, xi, yr, yi)
(
  i = 0; j = st;
  loop(n,
    m_fb[2*i] = m_rl[j]*win[i];
    m_fb[2*i+1] = m_rr[j]*win[i];
    j = (j + 1) & 65535;
    i += 1;
  );
  fft(m_fb, n);
  fft_permute(m_fb, n);
  k = 1;
  loop(n/2-1,
    a = m_fb[2*k]; b = m_fb[2*k+1];
    c = m_fb[2*(n-k)]; d = m_fb[2*(n-k)+1];
    xr = (a+c)*0.5; xi = (b-d)*0.5;
    yr = (b+d)*0.5; yi = (c-a)*0.5;
    sx[k] += (xr*xr + xi*xi - sx[k])*kf;
    sy[k] += (yr*yr + yi*yi - sy[k])*kf;
    sc[k] += (xr*yr + xi*yi - sc[k])*kf;
    ci ? ( ci[k] += (xi*yr - xr*yi - ci[k])*kf; );
    k += 1;
  );
);

// running sums, then every band of the given engine
function fbands(eng, n, sx, sy, sc, cx, cy, cc) local(i, k, nrm)
(
  cx[0] = cy[0] = cc[0] = 0;
  k = 0;
  loop(n/2,
    cx[k+1] = cx[k] + sx[k];
    cy[k+1] = cy[k] + sy[k];
    cc[k+1] = cc[k] + sc[k];
    k += 1;
  );
  nrm = 2/(n*n*0.375);                   // bin power to signal power (Hann, one-sided)
  i = 0;
  loop(nb,
    m_eng[i] == eng ? (
      fband(i, (fsum(cx, m_u1[i], n/2) - fsum(cx, m_u0[i], n/2))*nrm,
               (fsum(cy, m_u1[i], n/2) - fsum(cy, m_u0[i], n/2))*nrm,
               (fsum(cc, m_u1[i], n/2) - fsum(cc, m_u0[i], n/2))*nrm);
    );
    i += 1;
  );
);

// offset and polarity: the phase of the cross-spectrum alone (GCC-PHAT), back to time,
// strongest peak within 10 ms. Negative lag = the right side (or the sidechain) is late.
function foffset() local(k, re, im, mg, i, lm, bv, bi, v, s2, y0, y1, y2, den, fr)
(
  memset(m_fb, 0, 2*fn);
  k = 1;
  loop(fnb-1,
    re = m_sxy[k]; im = m_sxi[k];
    mg = sqrt(re*re + im*im);
    mg > tiny ? (
      m_fb[2*k] = re/mg; m_fb[2*k+1] = im/mg;
      m_fb[2*(fn-k)] = re/mg; m_fb[2*(fn-k)+1] = -im/mg;
    );
    k += 1;
  );
  fft_ipermute(m_fb, fn);
  ifft(m_fb, fn);
  lm = floor(0.01*srate);
  bv = 0; bi = 0; s2 = 0;
  i = -lm;
  loop(2*lm+1,
    v = m_fb[2*((i+fn) % fn)];
    s2 += v*v;
    abs(v) > abs(bv) ? ( bv = v; bi = i; );
    i += 1;
  );
  y0 = abs(m_fb[2*((bi-1+fn) % fn)]); y1 = abs(bv); y2 = abs(m_fb[2*((bi+1+fn) % fn)]);
  den = y0 - 2*y1 + y2;
  fr = den != 0 ? max(-0.5, min(0.5, 0.5*(y0-y2)/den)) : 0;
  ofs_conf = s2 > 0 ? abs(bv)/sqrt(s2/(2*lm+1)) : 0;
  ofs_ok = ofs_conf > 8 && bval;
  ofs_lag = bi + fr;
  ofs_sgn = bv < 0 ? -1 : 1;
);

// the long frame: spectrum and its bands. The offset follows in the next block.
function fframe()
(
  fspec(fn, fst1, m_win, m_sxx, m_syy, m_sxy, m_sxi, 1 - exp(-fhop/(max(1, slider3)*0.001*srate)));
  ffm ? fbands(0, fn, m_sxx, m_syy, m_sxy, m_cxx, m_cyy, m_cxy);
);

function fframe2()
(
  fspec(fs2, fst2, m_wi2, m_s2x, m_s2y, m_s2c, 0, 1 - exp(-fhop2/(max(1, slider3)*0.001*srate)));
  fbands(1, fs2, m_s2x, m_s2y, m_s2c, m_c2x, m_c2y, m_c2c);
);

// ---------------------------------------------------------------- drawing helpers
function ucol(c, a)
(
  gfx_r = ((c >> 16) & 255)/255;
  gfx_g = ((c >> 8) & 255)/255;
  gfx_b = (c & 255)/255;
  gfx_a = a;
);

function urr(x, y, w, h, rad, fill) local(rr)
(
  rr = floor(min(rad, min(w, h)/2));
  fill ? (
    rr < 1 ? gfx_rect(x, y, w, h) : (
      gfx_rect(x+rr, y, w-2*rr, h);
      gfx_rect(x, y+rr, rr, h-2*rr);
      gfx_rect(x+w-rr, y+rr, rr, h-2*rr);
      gfx_circle(x+rr, y+rr, rr, 1, 1);
      gfx_circle(x+w-rr-1, y+rr, rr, 1, 1);
      gfx_circle(x+rr, y+h-rr-1, rr, 1, 1);
      gfx_circle(x+w-rr-1, y+h-rr-1, rr, 1, 1);
    );
  ) : (
    gfx_roundrect(x, y, w-1, h-1, rr, 1);
  );
);

function uarc(cx, cy, rad, a1, a2, th) local(k)
(
  k = 0;
  loop(max(1, ceil(th*2)),
    gfx_arc(cx, cy, rad - th/2 + k*0.5, a1, a2, 1);
    k += 1;
  );
);

function uin(x, y, w, h)
(
  mouse_x >= x && mouse_x < x+w && mouse_y >= y && mouse_y < y+h;
);

function uinc(cx, cy, rad)
(
  sqr(mouse_x-cx) + sqr(mouse_y-cy) <= rad*rad;
);

// a correlation value with its sign, e.g. +0.84 / -0.31
function usign(dst, v)
(
  abs(v) < 0.005 ? sprintf(dst, "0.00") : v > 0 ? sprintf(dst, "+%.2f", v) : sprintf(dst, "-%.2f", -v);
);

function ufreq(dst, f)
(
  f < 100 ? sprintf(dst, "%.1f Hz", f) : f < 1000 ? sprintf(dst, "%d Hz", floor(f+0.5)) : sprintf(dst, "%.2f kHz", f/1000);
);

// controls: 1 bands, 2 selectivity, 3 averaging, each as 0..1 on its track
function ufrac(id)
(
  id == 1 ? slider1/9 : id == 2 ? slider2/100 : log(max(10, slider3)/10)/log(500);
);

function uset(id, f)
(
  f = max(0, min(1, f));
  id == 1 ? ( slider1 = floor(f*9+0.5); slider_automate(1); ) :
  id == 2 ? ( slider2 = floor(f*1000+0.5)/10; slider_automate(2); ) :
            ( slider3 = floor(10*500^f+0.5); slider_automate(4); );
);

function udef(id)
(
  id == 1 ? ( slider1 = 7; slider_automate(1); ) :
  id == 2 ? ( slider2 = 50; slider_automate(2); ) :
            ( slider3 = 300; slider_automate(4); );
);

// the mark, right edge at rx, centered on cy. Color: whatever ucol set before.
function ulogo(rx, cy) local(big, w, h, m, x0, y0, r, c, v)
(
  big = usc >= 1.5;
  w = big ? lgw2 : lgw1; h = big ? lgh2 : lgh1; m = big ? m_lg2 : m_lg1;
  x0 = floor(rx - w); y0 = floor(cy - h/2);
  r = 0;
  loop(h,
    c = 0;
    loop(w,
      v = m[r*w + c];
      v > 0 ? ( gfx_a = v/15; gfx_rect(x0+c, y0+r, 1, 1); );
      c += 1;
    );
    r += 1;
  );
);

// a color between two packed colors (t = 0: the first, 1: the second)
function umix(c1, c2, t)
(
  t = max(0, min(1, t));
  floor(((c1 >> 16) & 255)*(1-t) + ((c2 >> 16) & 255)*t + 0.5)*65536 +
  floor(((c1 >> 8) & 255)*(1-t) + ((c2 >> 8) & 255)*t + 0.5)*256 +
  floor((c1 & 255)*(1-t) + (c2 & 255)*t + 0.5);
);

// the color of a correlation value: from 0 up blue turns mint toward +1, below 0 coral turns red toward -1
function ucorrc(v)
(
  v >= 0 ? umix(ucBLUE, ucMINT, v/0.6) : umix(ucCORAL, ucRED, -v/0.6);
);

function ucorr(v, a)
(
  ucol(ucorrc(v), a);
);

// the same, mixed into the panel (a quiet band fades without transparency, so rounded shapes stay clean)
function ucorrm(v, a)
(
  ucol(umix(ucP, ucorrc(v), a), 1);
);

// a loudness against the target: mint on target, amber and red louder, blue much quieter
function lcolr(L, t, tol)
(
  L <= -70 ? ucDIM : L - t > tol + 2 ? ucRED : L - t > tol ? ucWARN : L - t < -(tol + 6) ? ucBLUE : ucMINT;
);

// the integrated loudness against the target, as the verdict judges it: delivery specs (EBU R128, Netflix) are red
// outside the tolerance, streaming services turn loud masters down (amber) and leave quiet ones quiet (blue)
function lvcol(L, t, tol, p)
(
  L <= -70 ? ucDIM : abs(L - t) <= tol ? ucMINT : p < 1.5 ? ucRED : L > t ? ucWARN : ucBLUE;
);

// a loudness to its height in the history graph
function lgmap(L)
(
  floor(lgy1 - lgh*max(0, min(1, (L - llo)/(lhi - llo))) + 0.5);
);

// layout units (680 x 520) to pixels
function ux(v) ( uox + v*usc; );
function uy(v) ( v*usc; );

// text centered on a point, left-aligned or right-aligned, always centered vertically on cy
function utc(str, cx, cy) local(tw, th)
(
  gfx_measurestr(str, tw, th);
  gfx_x = floor(cx - tw/2 + 0.5); gfx_y = floor(cy - th/2 + 0.5);
  gfx_drawstr(str);
);

function ulc(str, x, cy) local(tw, th)
(
  gfx_measurestr(str, tw, th);
  gfx_x = floor(x + 0.5); gfx_y = floor(cy - th/2 + 0.5);
  gfx_drawstr(str);
);

function urc(str, rx, cy) local(tw, th)
(
  gfx_measurestr(str, tw, th);
  gfx_x = floor(rx - tw + 0.5); gfx_y = floor(cy - th/2 + 0.5);
  gfx_drawstr(str);
);

// a straight stroke of width w as a filled shape (clean at any scale)
function uquad(x1, y1, x2, y2, w) local(dx, dy, l)
(
  dx = x2 - x1; dy = y2 - y1; l = max(0.0001, sqrt(dx*dx + dy*dy));
  dx = dx/l*w/2; dy = dy/l*w/2;
  gfx_triangle(x1 - dy, y1 + dx, x2 - dy, y2 + dx, x2 + dy, y2 - dx, x1 + dy, y1 - dx);
);

// a rotary control: label above, value below, a track with the setting as an accent arc and a pointer.
// Drag up or down.
function uknob(id, cx, cy, rad, f, label, val) local(hot, ang)
(
  hot = uhov == id || udrag == id || (id == 1 && udrag == 2);
  gfx_setfont(7); ucol(ucMUTED, 1); utc(label, cx, ulby);
  ucol(udark ? (hot ? ucLINE : ucP2) : (hot ? 0xC9DDEE : ucLINE), 1); uarc(cx, cy, rad, -2.356, 2.356, 3*usc);
  f > 0.002 ? ( ucol(ucACC, 1); uarc(cx, cy, rad, -2.356, -2.356 + 4.712*f, 3*usc); );
  ang = -2.356 + 4.712*f;
  ucol(ucTEXT, 1); uquad(cx, cy, cx + sin(ang)*(rad - 6*usc), cy - cos(ang)*(rad - 6*usc), 1.6*usc);
  gfx_setfont(13); ucol(ucTEXT, 1); utc(val, cx, unty);
  uinc(cx, cy, rad + 8*usc) ? uhov = id;
);

// a value to its height in the display: correlation +1..-1, or mono loss 0 dB..-range
function umap(v)
(
  uview ? floor(ugy + upt + (ugh-upt)*min(1, max(0, -v/urng)))
        : floor(ugy + ugh*(1-v)/2);
);

// a filled box: in light mode white with a thin line around it
function ubox(x, y, w, h, r)
(
  ucol(ucP2, 1); urr(x, y, w, h, r, 1);
  !udark ? ( ucol(ucLINE, 1); urr(x, y, w, h, r, 0); );
);

// a button: switched on it is filled with the accent
function ubtn(x, y, w, h, on, hot, str)
(
  on ? (
    ucol(ucACC, 1); urr(x, y, w, h, 8*usc, 1);
    gfx_setfont(6); ucol(ucACCT, 1);
  ) : (
    ucol(hot ? ucHOV : ucP2, 1); urr(x, y, w, h, 8*usc, 1);
    ucol(ucLINE, 1); urr(x, y, w, h, 8*usc, 0);
    gfx_setfont(9); ucol(ucTEXT, 1);
  );
  utc(str, x + w/2, y + h/2);
);

// a dropdown: the setting and a small triangle
function udrop(x, y, w, h, hot, str, fnt)
(
  ucol(hot ? ucHOV : ucP2, 1); urr(x, y, w, h, 8*usc, 1);
  ucol(ucLINE, 1); urr(x, y, w, h, 8*usc, 0);
  gfx_setfont(fnt); ucol(ucTEXT, 1); utc(str, x + (w - 12*usc)/2, y + h/2);
  ucol(ucMUTED, 1);
  gfx_triangle(x + w - 15*usc, y + h/2 - 2*usc, x + w - 9*usc, y + h/2 - 2*usc, x + w - 12*usc, y + h/2 + 2*usc);
);

lnb = -1;
setup();

// ---------------------------------------------------------------- dmajorsound logo
// The mark as a small bitmap in two sizes (1x and 2x), 16 levels of coverage per pixel (0-f),
// so it stays one single file and is drawn in the theme color.
m_lg1 = 430080;        // logo 1x
m_lg2 = 434176;        // logo 2x
function ldec(str, dst, n) local(i, c)
(
  i = 0;
  loop(n,
    c = str_getchar(str, i);
    dst[i] = c <= '9' ? c - '0' : c - 'a' + 10;
    i += 1;
  );
);
strcpy(#lg1, "");
strcat(#lg1, "0000007fffffefffffefd820");
strcat(#lg1, "0000008ffff84ffffc1fffe3");
strcat(#lg1, "0000008ffff84ffffc0ffffd");
strcat(#lg1, "0000008ffff84ffffc0fffff");
strcat(#lg1, "0000008ffff84ffffc0fffff");
strcat(#lg1, "0000008ffff84ffffc0fffff");
strcat(#lg1, "0000008ffff84ffffc0fffff");
strcat(#lg1, "0000008ffff8299996089998");
strcat(#lg1, "0016928ffff8000000000000");
strcat(#lg1, "06eff48ffff8000000000000");
strcat(#lg1, "5ffff48ffff8000000000000");
strcat(#lg1, "bffff48ffff8000000000000");
strcat(#lg1, "bffff48ffff8000000000000");
strcat(#lg1, "9ffff48ffff8000000000000");
strcat(#lg1, "1cfff48ffff8000000000000");
strcat(#lg1, "006ceefffff7000000000000");
lgw1 = 24; lgh1 = 16;
ldec(#lg1, m_lg1, 384);
strcpy(#lg2, "");
strcat(#lg2, "0000000000000bfffffffffffffffffffffffffec9500000");
strcat(#lg2, "0000000000000ffffffffffecfffffffffffcefffffe7000");
strcat(#lg2, "0000000000000ffffffffff309fffffffffa02fffffffc10");
strcat(#lg2, "0000000000000ffffffffff207fffffffff900ffffffffc0");
strcat(#lg2, "0000000000000ffffffffff207fffffffff900fffffffff7");
strcat(#lg2, "0000000000000ffffffffff207fffffffff900fffffffffd");
strcat(#lg2, "0000000000000ffffffffff207fffffffff900ffffffffff");
strcat(#lg2, "0000000000000ffffffffff207fffffffff900ffffffffff");
strcat(#lg2, "0000000000000ffffffffff207fffffffff900ffffffffff");
strcat(#lg2, "0000000000000ffffffffff207fffffffff900ffffffffff");
strcat(#lg2, "0000000000000ffffffffff207fffffffff900ffffffffff");
strcat(#lg2, "0000000000000ffffffffff207fffffffff900ffffffffff");
strcat(#lg2, "0000000000000ffffffffff207fffffffff900ffffffffff");
strcat(#lg2, "0000000000000ffffffffff207fffffffff900ffffffffff");
strcat(#lg2, "0000000000000ffffffffff206fffffffff800cffffffffe");
strcat(#lg2, "0000000000000ffffffffff2002333333330001333333331");
strcat(#lg2, "0000000013000ffffffffff2000000000000000000000000");
strcat(#lg2, "000004adff800ffffffffff2000000000000000000000000");
strcat(#lg2, "0003cfffff900ffffffffff2000000000000000000000000");
strcat(#lg2, "005effffff900ffffffffff2000000000000000000000000");
strcat(#lg2, "04ffffffff900ffffffffff2000000000000000000000000");
strcat(#lg2, "0dffffffff900ffffffffff2000000000000000000000000");
strcat(#lg2, "4fffffffff900ffffffffff2000000000000000000000000");
strcat(#lg2, "6fffffffff900ffffffffff2000000000000000000000000");
strcat(#lg2, "6fffffffff900ffffffffff2000000000000000000000000");
strcat(#lg2, "6fffffffff900ffffffffff2000000000000000000000000");
strcat(#lg2, "4fffffffff900ffffffffff2000000000000000000000000");
strcat(#lg2, "0cffffffff900ffffffffff2000000000000000000000000");
strcat(#lg2, "03efffffff900ffffffffff2000000000000000000000000");
strcat(#lg2, "004effffffb02ffffffffff2000000000000000000000000");
strcat(#lg2, "00019efffffdeffffffffff2000000000000000000000000");
strcat(#lg2, "0000016aceffffffffffffc0000000000000000000000000");
lgw2 = 48; lgh2 = 32;
ldec(#lg2, m_lg2, 1536);


// ---------------------------------------------------------------- loudness (ITU-R BS.1770-4 / EBU R128 / EBU Tech 3342)
// Measured on the main input. The timeline is cut into 100 ms slots; every slot keeps its momentary block (400 ms)
// and its short-term value (3 s), so a slot measured again (timecode: the same part played again) replaces the old one.
// Integrated and loudness range come from two histograms (0.1 LU steps from -70 to +10 LUFS) with the standard gates.
m_lme  = 1048576;      // per slot (5 hours of 100 ms): momentary block energy (0 = no block yet)
m_lse  = 1228800;      //   short-term energy (0 = none yet)
m_lhs  = 1409024;      //   1 = the slot holds a measurement
m_lhi  = 1589248;      // history: momentary energy of every measured slot, in order (5 hours)
m_hmc  = 1769472;      // histogram of the momentary blocks: counts
m_hme  = 1770496;      //   energies
m_hsc  = 1771520;      // histogram of the short-term values: counts
m_hse  = 1772544;      //   energies
m_lr30 = 1773568;      // the last 30 slot energies
m_wde  = 1773632;      // history graph: 360 steps, energy sum
m_wdn  = 1774080;      //   number of slots in it
m_tph  = 1774528;      // true peak: input history, left 16, right 16
m_tpc  = 1774592;      //   polyphase interpolation filter, up to 4 phases x 12 taps
m_wrr  = 1774656;      // history drawing: the height of every step (-1 = empty)
lN = 180000;

// K-weighting (shelf + high-pass): the BS.1770 filters re-derived for any sample rate (as libebur128 does;
// at 48 kHz they are the coefficients of the standard) and the true peak filter
function lcoef() local(K, Vh, Vb, Q, a0, L, c, t, x, w, p, k, s)
(
  K = tan($pi*1681.974450955533/srate); Q = 0.7071752369554196;
  Vh = 10^(3.999843853973347/20); Vb = Vh^0.4996667741545416;
  a0 = 1 + K/Q + K*K;
  kb0 = (Vh + Vb*K/Q + K*K)/a0; kb1 = 2*(K*K - Vh)/a0; kb2 = (Vh - Vb*K/Q + K*K)/a0;
  ka1 = 2*(K*K - 1)/a0; ka2 = (1 - K/Q + K*K)/a0;
  K = tan($pi*38.13547087613982/srate); Q = 0.5003270373253953;
  a0 = 1 + K/Q + K*K;
  hb0 = 1; hb1 = -2; hb2 = 1; ha1 = 2*(K*K - 1)/a0; ha2 = (1 - K/Q + K*K)/a0;
  // true peak: 4x oversampling up to 96 kHz, 2x above
  tpo = srate < 100000 ? 4 : 2;
  L = 12*tpo; c = (L-1)/2;
  t = 0;
  loop(L,
    x = (t - c)/tpo;
    w = 0.5 - 0.5*cos(2*$pi*(t+1)/(L+1));
    m_tpc[t] = (abs(x) < 0.000001 ? 1 : sin($pi*x)/($pi*x))*w;
    t += 1;
  );
  p = 0;
  loop(tpo,
    s = 0; k = 0;
    loop(12, s += m_tpc[p + tpo*k]; k += 1; );
    k = 0;
    loop(12, m_tpc[p + tpo*k] = m_tpc[p + tpo*k]/s; k += 1; );
    p += 1;
  );
  lsr2 = srate;
);

function lreset()
(
  memset(m_lme, 0, lN); memset(m_lse, 0, lN); memset(m_lhs, 0, lN);
  memset(m_hmc, 0, 4096);
  memset(m_lr30, 0, 32); memset(m_wde, 0, 360); memset(m_wdn, 0, 360); memset(m_tph, 0, 32);
  lk1l = lk2l = lk1r = lk2r = lh1l = lh2l = lh1r = lh2r = 0;
  lcur = -1000000000; lprev = lcur; lcont = 0; lsum = 0; lcnt = 0; lvn = 0;
  lri = 0; lmom = lst = -200; lnsl = 0; lht = 0; lrk = -1;
  lint = -200; llra = -1; ltpk = 0; ltpi = 0;
  ldirty = 0; lreq = 0;
);

// one value into or out of a histogram (absolute gate: below -70 LUFS it is not counted)
function lhist(e, cn, en, sg) local(L, b)
(
  e > 0 ? (
    L = -0.691 + 10*log10(e);
    L >= -70 ? (
      b = min(799, floor((L+70)*10));
      cn[b] += sg; en[b] += sg*e;
    );
  );
);

// a finished slot into the timeline, replacing whatever was measured there before
function lstore(sid, em, es) local(i)
(
  i = sid - floor(sid/lN)*lN;
  m_lhs[i] ? ( lhist(m_lme[i], m_hmc, m_hme, -1); lhist(m_lse[i], m_hsc, m_hse, -1); lnsl -= 1; );
  m_lme[i] = em; m_lse[i] = es; m_lhs[i] = 1;
  lhist(em, m_hmc, m_hme, 1); lhist(es, m_hsc, m_hse, 1);
  lnsl += 1;
);

// history: the span in slots, by the History setting
function lrspan()
(
  slider12 < 0.5 ? 600 : slider12 < 1.5 ? 3000 : slider12 < 2.5 ? 9000 : slider12 < 3.5 ? 18000 :
  slider12 < 4.5 ? 36000 : slider12 < 5.5 ? 72000 : 180000;
);

function lradd(e) local(S, k)
(
  S = lrspan();
  m_lhi[lht % lN] = e;
  k = floor((lht % S)*360/S);
  k != lrk ? ( m_wde[k] = 0; m_wdn[k] = 0; lrk = k; );
  m_wde[k] += e; m_wdn[k] += 1;
  lht += 1;
);

// a new span: the steps are rebuilt from the history
function lrbuild() local(S, n, j, k)
(
  S = lrspan();
  memset(m_wde, 0, 360); memset(m_wdn, 0, 360);
  n = min(lht, S); j = lht - n; lrk = -1;
  loop(n,
    k = floor((j % S)*360/S);
    m_wde[k] += m_lhi[j % lN]; m_wdn[k] += 1; lrk = k;
    j += 1;
  );
  lrsp = slider12;
);

// the slot that just ended: momentary (last 4 slots), short-term (last 30), into the timeline and the history
function lslot() local(e, i, n, em, es)
(
  e = lsum/lcnt;
  lcont = lcur == lprev + 1 ? lcont + 1 : 1;     // a jump (timecode) starts the blocks again
  lprev = lcur;
  m_lr30[lri] = e; lri = (lri + 1) % 30;
  em = 0; i = 0; n = min(4, lcont);
  loop(n, em += m_lr30[(lri - 1 - i + 60) % 30]; i += 1; );
  em = em/n;
  es = 0; i = 0; n = min(30, lcont);
  loop(n, es += m_lr30[(lri - 1 - i + 60) % 30]; i += 1; );
  es = es/n;
  lmom = em > 0 ? -0.691 + 10*log10(em) : -200;
  lst = es > 0 ? -0.691 + 10*log10(es) : -200;
  lstore(lcur, lcont >= 4 ? em : 0, lcont >= 30 ? es : 0);
  lradd(em);
  ldirty = 1;
);

// integrated (gates -70 and -10) and loudness range (gates -70 and -20, 10th to 95th percentile)
function lcalc() local(b, n, e, g, n2, e2, cum, lo, hi)
(
  n = 0; e = 0; b = 0;
  loop(800, n += m_hmc[b]; e += m_hme[b]; b += 1; );
  lint = -200;
  (n > 0.5 && e > 0) ? (
    g = max(0, ceil((-0.691 + 10*log10(e/n) - 10 + 70)*10));
    n2 = 0; e2 = 0; b = g;
    loop(max(0, 800 - g), n2 += m_hmc[b]; e2 += m_hme[b]; b += 1; );
    (n2 > 0.5 && e2 > 0) ? lint = -0.691 + 10*log10(e2/n2);
  );
  n = 0; e = 0; b = 0;
  loop(800, n += m_hsc[b]; e += m_hse[b]; b += 1; );
  llra = -1;
  (n > 0.5 && e > 0) ? (
    g = max(0, ceil((-0.691 + 10*log10(e/n) - 20 + 70)*10));
    n2 = 0; b = g;
    loop(max(0, 800 - g), n2 += m_hsc[b]; b += 1; );
    n2 > 0.5 ? (
      cum = 0; b = g; lo = -1; hi = -1;
      loop(max(0, 800 - g),
        cum += m_hsc[b];
        (lo < 0 && cum >= 0.1*n2) ? lo = b;
        (hi < 0 && cum >= 0.95*n2) ? hi = b;
        b += 1;
      );
      llra = max(0, (hi - lo)*0.1);
    );
  );
  ldirty = 0;
);

// the targets: 0 EBU R128, 1 Netflix, 2 Spotify, 3 YouTube, 4 Apple Music, 5 Tidal
function ltgt(p) ( p < 0.5 ? -23 : p < 1.5 ? -27 : p > 3.5 && p < 4.5 ? -16 : -14; );
function ltol(p) ( p < 0.5 ? 0.5 : p < 1.5 ? 2 : 1; );
function ltpl(p) ( p > 0.5 && p < 1.5 ? -2 : -1; );

lcoef(); lreset(); lmd = slider11; lrsp = slider12;


@slider
// changes are picked up in @block, so drags from the window behave the same

@block
(slider1 != lnb || slider2 != lsel || srate != lsr || slider4 != lin) ? setup();
// loudness: a new sample rate or a new way of measuring starts a new measurement; Reset asks for one too
lsr2 != srate ? ( lcoef(); lreset(); );
slider11 != lmd ? ( lmd = slider11; lreset(); );
lreq ? lreset();
lrsp != slider12 ? lrbuild();
ldirty ? lcalc();
lmeas = slider6 < 0.5 && (slider11 < 0.5 || (play_state & 1));   // Playback and Timecode: only while the DAW plays (or records)
lpos0 = play_position; lsmp = 0;
!lmeas && lcnt > 0 ? ( lslot(); lsum = 0; lcnt = 0; );   // stopped: the slot in progress counts as it is
kav = 1 - exp(-1000/(max(1, slider3)*srate));
inm = slider4 >= 0.5;
mon = slider6 < 0.5;                     // frozen: analysis stops, the display keeps the last picture

mon ? (
  // the FFT work, spread over the blocks so no single block carries all of it:
  // short frame when due, then either the offset of the last long frame or a new long frame
  f2pend ? ( f2pend = 0; fframe2(); );
  foffp ? ( foffp = 0; foffset(); ) : fpend ? ( fpend = 0; fframe(); foffp = (fofc += 1) & 1; );
  dt = samplesblock/srate;
  hm = slider5;
  i = 0;
  loop(nb,
    !ffm ? (
      p = m_st + i*32;
      fband(i, p[21], p[22], p[20]);
    );
    rr = m_cor[i];
    m_val[i] ? (
      (hm < 0.5 || rr < m_hld[i] || req_clr) ? (
        m_hld[i] = rr; m_ht[i] = 0;
      ) : (
        m_ht[i] += dt;
        (hm < 1.5 && m_ht[i] > 3) ? ( m_hld[i] = min(rr, m_hld[i] + dt*0.5); );
      );
      // the deepest mono loss, held the same way (released at 6 dB per second)
      (hm < 0.5 || req_clr || m_mon[i] < m_hmo[i]) ? (
        m_hmo[i] = m_mon[i]; m_hmt[i] = 0;
      ) : (
        m_hmt[i] += dt;
        (hm < 1.5 && m_hmt[i] > 3) ? ( m_hmo[i] = min(m_mon[i], m_hmo[i] + dt*6); );
      );
    ) : (
      req_clr ? ( m_hld[i] = 1; m_ht[i] = 0; m_hmo[i] = 0; );
    );
    i += 1;
  );
  // the full signal, as on a classic correlation meter
  dd = sqrt(bxx*byy);
  bcor = dd > tiny ? max(-1, min(1, bxy/dd)) : 0;
  blev_l = 10*log10(bxx+tiny);
  blev_r = 10*log10(byy+tiny);
  // balance (left over right) and width (side over mid), for the goniometer page
  bbal = blev_l - blev_r;
  bwid = 10*log10((bxx+byy-2*bxy)*0.5 + tiny) - 10*log10((bxx+byy+2*bxy)*0.5 + tiny);
  bval = blev_l > -100 || blev_r > -100;
  bval ? (
    (hm < 0.5 || bcor < bhld || req_clr) ? (
      bhld = bcor; bht = 0;
    ) : (
      bht += dt;
      (hm < 1.5 && bht > 3) ? ( bhld = min(bcor, bhld + dt*0.5); );
    );
  ) : (
    req_clr ? ( bhld = 1; bht = 0; );
  );
  req_clr = 0;
);

@sample
// the audio is never touched: spl0 / spl1 leave as they came in
mon ? (
  inm ? (
    xl = (spl0+spl1)*0.5; xr = (spl2+spl3)*0.5;
  ) : (
    xl = spl0; xr = spl1;
  );
  dnz = -dnz;
  xl += dnz; xr += dnz;
  bxy += (xl*xr - bxy)*kav;
  bxx += (xl*xl - bxx)*kav;
  byy += (xr*xr - byy)*kav;
  // goniometer: rotated by 45 degrees, mid straight up, left to the upper left
  m_gx[gwp] = (xr - xl)*0.70711;
  m_gy[gwp] = (xl + xr)*0.70711;
  gwp = (gwp + 1) & 8191;
  // history for the FFTs (the work itself runs in @block): the long one always (offset, polarity), the short one with 128 / 256 bands
  m_rl[fwp] = xl; m_rr[fwp] = xr;
  fwp = (fwp + 1) & 65535;
  fhc += 1;
  fhc >= fhop ? ( fhc = 0; fst1 = (fwp - fn + 65536) & 65535; fpend = 1; );
  ffm ? (
    fhc2 += 1;
    fhc2 >= fhop2 ? ( fhc2 = 0; fst2 = (fwp - fs2 + 65536) & 65535; f2pend = 1; );
  ) : (
    p = m_st;
    loop(nb,
      c0 = p[0]; c1 = p[1]; c2 = p[2];
      // left, stage 1 and 2
      ys = c0*(xl - p[5]) - c1*p[6] - c2*p[7];
      p[5] = p[4]; p[4] = xl; p[7] = p[6]; p[6] = ys;
      zl = c0*(ys - p[9]) - c1*p[10] - c2*p[11];
      p[9] = p[8]; p[8] = ys; p[11] = p[10]; p[10] = zl;
      // right, stage 1 and 2
      ys = c0*(xr - p[13]) - c1*p[14] - c2*p[15];
      p[13] = p[12]; p[12] = xr; p[15] = p[14]; p[14] = ys;
      zr = c0*(ys - p[17]) - c1*p[18] - c2*p[19];
      p[17] = p[16]; p[16] = ys; p[19] = p[18]; p[18] = zr;
      // averages: cross product and the two powers
      p[20] += (zl*zr - p[20])*kav;
      p[21] += (zl*zl - p[21])*kav;
      p[22] += (zr*zr - p[22])*kav;
      p += 32;
    );
  );
);
// loudness, on the main input (inputs 1/2), only while measuring
lmeas ? (
  // K-weighting: shelf, then high-pass (transposed direct form II)
  ly = kb0*(spl0+dnz) + lk1l; lk1l = kb1*(spl0+dnz) - ka1*ly + lk2l; lk2l = kb2*(spl0+dnz) - ka2*ly;
  lzl = hb0*ly + lh1l; lh1l = hb1*ly - ha1*lzl + lh2l; lh2l = hb2*ly - ha2*lzl;
  ly = kb0*(spl1+dnz) + lk1r; lk1r = kb1*(spl1+dnz) - ka1*ly + lk2r; lk2r = kb2*(spl1+dnz) - ka2*ly;
  lzr = hb0*ly + lh1r; lh1r = hb1*ly - ha1*lzr + lh2r; lh2r = hb2*ly - ha2*lzr;
  // the 100 ms slot of this sample: by the DAW position (Timecode) or by the measured time
  lsid = floor((slider11 >= 1.5 ? lpos0 + lsmp/srate : lvn/srate)*10 + 0.000001);
  lsid != lcur ? (
    lcnt > 0 ? lslot();
    lcur = lsid; lsum = 0; lcnt = 0;
  );
  lsum += lzl*lzl + lzr*lzr; lcnt += 1;
  lvn += 1;
);
// true peak per side (the samples and the points between them): for the peak meters always while the meter runs,
// into True peak max only while measuring
mon ? (
  m_tph[ltpi] = spl0; m_tph[16 + ltpi] = spl1;
  lpl = abs(spl0); lpr = abs(spl1);
  tpo > 1 ? (
    tp_p = 0;
    loop(tpo,
      tp_l = 0; tp_r = 0; tp_k = 0;
      loop(12,
        tp_c = m_tpc[tp_p + tpo*tp_k]; tp_j = (ltpi - tp_k) & 15;
        tp_l += tp_c*m_tph[tp_j]; tp_r += tp_c*m_tph[16 + tp_j];
        tp_k += 1;
      );
      lpl = max(lpl, abs(tp_l)); lpr = max(lpr, abs(tp_r));
      tp_p += 1;
    );
  );
  ltpi = (ltpi + 1) & 15;
  lpl > lpkl ? lpkl = lpl;              // the meters take these and set them back to 0
  lpr > lpkr ? lpkr = lpr;
  lmeas ? ( lpk = max(lpl, lpr); lpk > ltpk ? ltpk = lpk; );
);
lsmp += 1;

@gfx 680 520
// ---- theme: calm panels, one accent for what is switched on, color only for signals
udark = slider7 < 0.5;
udark ? (
  ucBG = 0x121418; ucP = 0x1C1F24; ucP2 = 0x262A30; ucLINE = 0x30343B; ucGRID = 0x24282E; ucHOV = 0x30343B;
  ucTEXT = 0xE8EAED; ucMUTED = 0x9AA0A8; ucDIM = 0x686E77;
  ucACC = 0x8CC8F2; ucACCT = 0x0F2638; ucACC2 = 0x2F5675; ucACC2T = 0xFFFFFF;
  ucMINT = 0x8FE3B0; ucBLUE = 0x8CC8F2; ucCORAL = 0xF59A6B; ucRED = 0xF06E6E; ucWARN = 0xF2B36B;
) : (
  // light mode is white: every surface white, set apart by thin lines only; hover is a light accent tint
  ucBG = 0xFFFFFF; ucP = 0xFFFFFF; ucP2 = 0xFFFFFF; ucLINE = 0xDFE3E8; ucGRID = 0xF0F2F5; ucHOV = 0xEAF4FC;
  ucTEXT = 0x1C1F24; ucMUTED = 0x626870; ucDIM = 0x969BA2;
  ucACC = 0x8CC8F2; ucACCT = 0x0F2638; ucACC2 = 0x2F5675; ucACC2T = 0xFFFFFF;
  ucMINT = 0x1F9D63; ucBLUE = 0x3880C4; ucCORAL = 0xE2784A; ucRED = 0xD64848; ucWARN = 0xD48C28;
);

usc = max(0.5, min(gfx_w/680, gfx_h/520));
// frame time: fades and decays run per second, not per frame (same look at 30 or 60 frames per second)
uftn = time_precise(); uft = max(0.25, min(3, (uftn - uftl)*30)); uftl = uftn;
uex = max(0, gfx_h/usc - 520);           // extra height goes to the display
uwx = max(0, floor(gfx_w/usc - 680));    // extra width goes to the display too
uwp = floor(uwx*usc);                    // the same in pixels, for everything anchored on the right
uey = floor(uex*usc);                    // extra height in pixels, for everything below the display
uox = floor((gfx_w - (680+uwx)*usc)/2);
ulb = mouse_cap & 1;
upress = ulb && !ulbp;
uhov = 0;
uon = 1;
ufrz = slider6 >= 0.5;                   // switched off: the meter keeps its last picture
unb = nb;
umode = floor(slider8+0.5);
uview = umode == 1;                      // mono loss
ugon = umode == 2;                       // goniometer
uloud = umode == 3;                      // loudness

ucol(ucBG, 1); gfx_rect(0, 0, gfx_w, gfx_h);
// type: Mulish for words, Red Hat Mono for numbers (both embedded in the plug-in)
gfx_setfont(1, "Mulish Bold", 17*usc);
gfx_setfont(2, "Mulish", 9.5*usc);
gfx_setfont(3, "Red Hat Mono", 7.5*usc);
gfx_setfont(4, "Red Hat Mono SemiBold", 10*usc);
gfx_setfont(5, "Red Hat Mono SemiBold", 13*usc);
gfx_setfont(6, "Mulish SemiBold", 9.5*usc);
gfx_setfont(7, "Mulish SemiBold", 9*usc);
gfx_setfont(8, "Mulish", 8.5*usc);
gfx_setfont(9, "Mulish", 9*usc);
gfx_setfont(10, "Mulish", 8*usc);
gfx_setfont(11, "Red Hat Mono SemiBold", 21*usc);
gfx_setfont(12, "Red Hat Mono", 11.5*usc);
gfx_setfont(13, "Red Hat Mono", 9.5*usc);
gfx_setfont(14, "Mulish Bold", 14*usc);
gfx_setfont(15, "Mulish SemiBold", 11*usc);
gfx_setfont(16, "Red Hat Mono", 7*usc);

// ---- header
// on / off: a round power button. On (blue) = the meter runs. Off = it keeps the last picture; the audio always passes.
upx = ux(28); upy = uy(26); upr = 11*usc;
uinc(upx, upy, upr+3*usc) ? uhov = 10;
ucol(!ufrz ? ucACC : (uhov == 10 ? ucTEXT : ucDIM), 1);
uarc(upx, upy, upr, 0, 6.2832, 1.6*usc);
uarc(upx, upy, 6*usc, 0.55, 5.73, 1.6*usc);
uquad(upx, upy - 7.5*usc, upx, upy - 1*usc, 1.6*usc);
// the Binocular mark: two rings, blue and mint like the meter
ucol(ucBLUE, 1); uarc(ux(54), uy(26), 7.5*usc, 0, 6.2832, 1.8*usc);
ucol(ucMINT, 1); uarc(ux(63), uy(26), 7.5*usc, 0, 6.2832, 1.8*usc);
gfx_setfont(1); ucol(ucTEXT, 1); gfx_x = ux(78); gfx_y = floor(uy(3.9)); gfx_drawstr("Binocular");
gfx_setfont(2); ucol(ucMUTED, 1); gfx_x = ux(79); gfx_y = floor(uy(26.45)); gfx_drawstr("Mmm…etering!");

// views: one segmented control
ucol(ucP, 1); urr(ux(190), uy(12), 294*usc, 28*usc, 14*usc, 1);
ucol(ucLINE, 1); urr(ux(190), uy(12), 294*usc, 28*usc, 14*usc, 0);
uk = 0;
loop(4,
  usx = ux(193 + uk*72);
  usid = uk == 0 ? 30 : uk == 1 ? 31 : uk == 2 ? 35 : 36;
  uin(usx, uy(15), 72*usc, 22*usc) ? uhov = usid;
  umode == uk ? (
    ucol(ucACC, 1); urr(usx, uy(15), 72*usc, 22*usc, 11*usc, 1);
    gfx_setfont(6); ucol(ucACCT, 1);
  ) : (
    uhov == usid ? ( ucol(ucHOV, 1); urr(usx, uy(15), 72*usc, 22*usc, 11*usc, 1); );
    gfx_setfont(2); ucol(uhov == usid ? ucTEXT : ucMUTED, 1);
  );
  utc(uk == 0 ? "Correlation" : uk == 1 ? "Mono loss" : uk == 2 ? "Goniometer" : "Loudness", usx + 36*usc, uy(26.5));
  uk += 1;
);

// input: Stereo (L vs R) or Sidechain (this track vs inputs 3/4)
inm = slider4 >= 0.5;
ucol(ucP, 1); urr(ux(492) + uwp, uy(12), 112*usc, 28*usc, 14*usc, 1);
ucol(ucLINE, 1); urr(ux(492) + uwp, uy(12), 112*usc, 28*usc, 14*usc, 0);
uk = 0;
loop(2,
  usx = ux(uk == 0 ? 495 : 547) + uwp; usw = (uk == 0 ? 50 : 54)*usc;
  uin(usx, uy(15), usw, 22*usc) ? uhov = 11 + uk;
  (uk == 0 ? !inm : inm) ? (
    ucol(ucACC2, 1); urr(usx, uy(15), usw, 22*usc, 11*usc, 1);
    gfx_setfont(6); ucol(ucACC2T, 1);
  ) : (
    uhov == 11 + uk ? ( ucol(ucHOV, 1); urr(usx, uy(15), usw, 22*usc, 11*usc, 1); );
    gfx_setfont(2); ucol(uhov == 11 + uk ? ucTEXT : ucMUTED, 1);
  );
  utc(uk == 0 ? "Stereo" : "Sidechain", usx + usw/2, uy(26.5));
  uk += 1;
);

// help: a round "?"
uqx = ux(627) + uwp; uqy = uy(26);
uinc(uqx, uqy, 12*usc) ? uhov = 41;
ucol(uhelp ? ucACC : (uhov == 41 ? ucHOV : ucP), 1); gfx_circle(uqx, uqy, 11*usc, 1, 1);
!uhelp ? ( ucol(ucLINE, 1); gfx_circle(uqx, uqy, 11*usc, 0, 1); );
gfx_setfont(15); ucol(uhelp ? ucACCT : (uhov == 41 ? ucTEXT : ucMUTED), 1); utc("?", uqx + 0.5*usc, uqy);

// theme: dark = a crescent moon, light = a sun
utx = ux(656) + uwp; uty = uy(26);
uinc(utx, uty, 12*usc) ? uhov = 13;
ucol(uhov == 13 ? ucTEXT : ucMUTED, 1);
udark ? (
  gfx_circle(utx, uty, 8*usc, 1, 1);
  ucol(ucBG, 1); gfx_circle(utx + 4*usc, uty - 3*usc, 8*usc, 1, 1);
) : (
  uarc(utx, uty, 4.2*usc, 0, 6.2832, 1.4*usc);
  uri = 0;
  loop(8,
    ura = uri*0.7854;
    uquad(utx+sin(ura)*6.6*usc, uty-cos(ura)*6.6*usc, utx+sin(ura)*9*usc, uty-cos(ura)*9*usc, 1.4*usc);
    uri += 1;
  );
);

// ---- display panel
udx = ux(16); udw = (648+uwx)*usc; udy = uy(52); udh = (286+uex)*usc;
ucol(ucP, 1); urr(udx, udy, udw, udh, 10*usc, 1);
ucol(ucLINE, 1); urr(udx, udy, udw, udh, 10*usc, 0);

// correlation / mono loss: +1 top, -1 bottom, or 0 dB top down to the range
ugx = ux(46); ugw = (608+uwx)*usc;
ugy = uy(62); ugh = (250+uex)*usc;
upd = 0;
upt = uview ? 26*usc : 0;                // mono loss: room on top for the range button
urng = slider9 < 0.5 ? 24 : slider9 < 1.5 ? 48 : 96;
umode <= 1 ? (
  // a faint red ground where the mono sum loses level: below 0 / below -3 dB
  uyt = uview ? umap(-3) : floor(ugy + ugh/2);
  ucol(ucRED, udark ? 0.035 : 0.03); gfx_rect(ugx, uyt, ugw, ugy + ugh - uyt);
  // grid and scale: five marks. Mono loss 24 dB: 0 -3 -6 -12 -24, 48 dB: 0 -6 -12 -24 -48, 96 dB: 0 -12 -24 -48 -96
  gfx_setfont(3);
  uk = 0;
  loop(5,
    uview ? (
      uv = uk == 0 ? 0 : -(urng/8)*2^(uk-1);
      uv == 0 ? strcpy(#ulab, "0 dB") : sprintf(#ulab, "%d", uv);
      ucol(uv == -3 ? ucLINE : ucGRID, 1);
    ) : (
      uv = 1 - uk*0.5;
      strcpy(#ulab, uk == 0 ? "+1" : uk == 1 ? "+0.5" : uk == 2 ? "0" : uk == 3 ? "-0.5" : "-1");
      ucol(uk == 2 ? ucLINE : ucGRID, 1);
    );
    uyy = umap(uv);
    gfx_rect(ugx, uyy, ugw, max(1, floor(0.8*usc)));
    ucol(ucDIM, 1); urc(#ulab, ux(40), uyy);
    uk += 1;
  );
  // frequency grid
  ulfr = log(fhi/flo);
  uk = 0;
  loop(10,
    uf = uk == 0 ? 20 : uk == 1 ? 50 : uk == 2 ? 100 : uk == 3 ? 200 : uk == 4 ? 500 : uk == 5 ? 1000 :
         uk == 6 ? 2000 : uk == 7 ? 5000 : uk == 8 ? 10000 : 20000;
    uf <= fhi*1.001 ? (
      uxx = floor(ugx + ugw*log(uf/flo)/ulfr);
      ucol(ucGRID, 1); gfx_rect(uxx, ugy, 1, ugh);
      uf < 1000 ? sprintf(#ulab, "%d", uf) : sprintf(#ulab, "%dk", uf/1000);
      ucol(ucDIM, 1); utc(#ulab, uxx, ugy + ugh + 12*usc);
    );
    uk += 1;
  );

  // bars: color follows the correlation, height follows the view
  uxw = ugw/max(1, unb);
  ubw = uxw >= 5*usc ? max(1, floor(uxw - 2*usc)) : max(1, floor(uxw*0.72));
  ubr = ubw >= 4*usc ? 1.5*usc : 0;
  uy0 = umap(0);
  uhb = -1;
  uin(ugx, ugy, ugw, ugh) ? (
    uhov = 20;
    uhb = max(0, min(unb-1, floor((mouse_x-ugx)/uxw)));
    ucol(ucLINE, 0.5); gfx_rect(floor(ugx + uhb*uxw), ugy, ceil(uxw), ugh);
  );
  unb <= 128 ? (
    ui = 0;
    loop(unb,
      ubx = floor(ugx + (ui+0.5)*uxw - ubw/2);
      m_val[ui] ? (
        uc = m_cor[ui];
        uv = uview ? m_mon[ui] : uc;
        uvh = uview ? m_hmo[ui] : m_hld[ui];
        ua = max(0.3, min(1, (m_lev[ui]+80)/50));   // quiet bands fade into the panel
        uyv = umap(uv);
        ucorrm(uc, ua);
        ubh = max(1, abs(uyv - uy0));
        urr(ubx, min(uyv, uy0), ubw, ubh, ubh >= 2*ubr + 2 ? ubr : 0, 1);   // very short bars stay square
        // the lowest reading held: a short line in text color
        (slider5 >= 0.5 && uvh < uv - (uview ? 0.5 : 0.02)) ? (
          ucol(ucTEXT, 0.85); gfx_rect(ubx, umap(uvh), ubw, max(1, floor(1.5*usc)));
        );
      );
      ui += 1;
    );
  ) : (
    // more bands than room for bars: one pixel column each, the worst band of a column is shown
    upx = 0;
    loop(ugw,
      ub0 = floor(upx*unb/ugw); ub1 = max(ub0, floor((upx+1)*unb/ugw)-1);
      uvm = 1000; uhm = 1000; ulm = -200; ucm = 0; ufound = 0;
      ui = ub0;
      loop(ub1-ub0+1,
        m_val[ui] ? (
          uv = uview ? m_mon[ui] : m_cor[ui];
          uv < uvm ? ( uvm = uv; ulm = m_lev[ui]; ucm = m_cor[ui]; );
          uhm = min(uhm, uview ? m_hmo[ui] : m_hld[ui]);
          ufound = 1;
        );
        ui += 1;
      );
      ufound ? (
        ua = max(0.3, min(1, (ulm+80)/50));
        uyv = umap(uvm);
        ucorrm(ucm, ua);
        uyv < uy0 ? gfx_rect(ugx+upx, uyv, 1, uy0-uyv) : gfx_rect(ugx+upx, uy0, 1, max(1, uyv-uy0));
        (slider5 >= 0.5 && uhm < uvm - (uview ? 0.5 : 0.02)) ? (
          ucol(ucTEXT, 0.85); gfx_rect(ugx+upx, umap(uhm), 1, max(1, floor(1.5*usc)));
        );
      );
      upx += 1;
    );
  );
  // reference curve: a thin line through the band centers, broken where a band had no signal
  (refon && urnb == unb) ? (
    ucol(ucTEXT, 0.75);
    ulp = 0;
    ui = 0;
    loop(unb,
      m_rfv[ui] ? (
        uxx = ugx + (ui+0.5)*uxw; uyy = umap(uview ? m_rfm[ui] : m_rfc[ui]);
        ulp ? ( gfx_line(ulx, uly, uxx, uyy, 1); gfx_line(ulx, uly+1, uxx, uyy+1, 1); );
        ulx = uxx; uly = uyy; ulp = 1;
      ) : ( ulp = 0; );
      ui += 1;
    );
  );
  // range button, mono loss only: top right inside the display
  uview ? (
    gfx_setfont(9);
    sprintf(#urs, "Range %d dB", urng);
    gfx_measurestr(#urs, ultw, ulth);
    urw = floor(ultw + 20*usc); urh = floor(20*usc);
    urx2 = floor(ugx + ugw - urw); ury2 = floor(ugy);
    uin(urx2, ury2, urw, urh) ? uhov = 32;
    ubtn(urx2, ury2, urw, urh, 0, uhov == 32, #urs);
  );
);

ugon ? (
  // ---- goniometer: a square in the middle, balance on the left, width on the right
  ugs = floor((262+uex)*usc);
  ugcx = floor(udx + udw/2); ugcy = floor(udy + udh/2);
  ugr = ugs/2 - 8*usc;
  // the trace is drawn into its own image, which fades a little every frame (afterglow)
  (ugs != ugbs || ucP != ugbc) ? (
    gfx_setimgdim(1, ugs, ugs); ugbs = ugs; ugbc = ucP;
    gfx_dest = 1; ucol(ucP, 1); gfx_rect(0, 0, ugs, ugs); gfx_dest = -1;
  );
  gfx_dest = 1;
  !ufrz ? ( ucol(ucP, 1 - 0.7^uft); gfx_rect(0, 0, ugs, ugs); );
  // scale under the trace, so a mono trace on the M axis stays visible
  ugh2 = floor(ugs/2);
  ucol(ucGRID, 1);
  gfx_line(ugh2 - ugr, ugh2, ugh2 + ugr, ugh2, 1);
  gfx_line(ugh2 - ugr*0.7071, ugh2 - ugr*0.7071, ugh2 + ugr*0.7071, ugh2 + ugr*0.7071, 1);
  gfx_line(ugh2 + ugr*0.7071, ugh2 - ugr*0.7071, ugh2 - ugr*0.7071, ugh2 + ugr*0.7071, 1);
  ucol(ucLINE, 1); gfx_circle(ugh2, ugh2, ugr, 0, 1); gfx_circle(ugh2, ugh2, ugr*0.5, 0, 1);
  gfx_line(ugh2, ugh2 - ugr, ugh2, ugh2 + ugr, 1);
  // the samples since the last frame (at most 4096), starting at the last point of the previous frame (no gaps)
  ugn = min(4096, (gwp - ugrp + 8192) & 8191) + 1;
  ugst = (gwp - ugn + 8192) & 8191;
  ugpk2 = 0;
  ui = 0;
  loop(ugn,
    ugj = (ugst + ui) & 8191;
    ugpk2 = max(ugpk2, sqr(m_gx[ugj]) + sqr(m_gy[ugj]));
    ui += 1;
  );
  // automatic gain: follows the loudest point, falls back slowly, at most +40 dB
  ugpk = max(sqrt(ugpk2), ugpk*0.96^uft);
  ugain = min(100, 0.9/max(ugpk, 10^-9));
  ugn > 1 ? (
    ucorr(bcor, 0.85);
    upass = 0;
    loop(usc >= 1.5 ? 2 : 1,
      ui = 0;
      loop(ugn,
        ugj = (ugst + ui) & 8191;
        ugpx = max(0, min(ugs-2, ugh2 + m_gx[ugj]*ugain*ugr + upass));
        ugpy = max(0, min(ugs-2, ugh2 - m_gy[ugj]*ugain*ugr));
        ui == 0 ? ( gfx_x = ugpx; gfx_y = ugpy; ) : gfx_lineto(ugpx, ugpy, 1);
        ui += 1;
      );
      upass += 1;
    );
  );
  ugrp = gwp;
  gfx_dest = -1;
  gfx_a = 1;
  gfx_blit(1, 1, 0, 0, 0, ugs, ugs, ugcx - ugh2, ugcy - ugh2, ugs, ugs);
  // scale labels: mid (up), side (across), left and right diagonals
  gfx_setfont(7); ucol(ucDIM, 1);
  utc("M", ugcx, ugcy - ugr - 9*usc);
  utc(inm ? "Main" : "L", ugcx - ugr*0.7071 - (inm ? 14 : 8)*usc, ugcy - ugr*0.7071 - 6*usc);
  utc(inm ? "SC" : "R", ugcx + ugr*0.7071 + 9*usc, ugcy - ugr*0.7071 - 6*usc);
  urc("+S", ugcx - ugr - 5*usc, ugcy);
  ulc("-S", ugcx + ugr + 5*usc, ugcy);
  gfx_setfont(8); ucol(ucDIM, 1);
  ugdb = floor(20*log10(ugain)+0.5);
  ugdb > 0 ? sprintf(#ugt, "Auto gain +%d dB", ugdb) : ugdb < 0 ? sprintf(#ugt, "Auto gain %d dB", ugdb) : strcpy(#ugt, "Auto gain 0 dB");
  urc(#ugt, udx + udw - 14*usc, udy + udh - 14*usc);
  uin(ugcx - ugh2, udy, ugs, udh) ? uhov = 22;

  // side panels: balance and width, each a value and a bar
  ucpw = floor(150*usc);
  uk = 0;
  loop(2,
    ucpx = uk == 0 ? floor(udx + 26*usc) : floor(udx + udw - 26*usc - ucpw);
    ucpy = floor(ugcy - 30*usc);
    gfx_setfont(7); ucol(ucMUTED, 1); utc(uk == 0 ? "Balance" : "Width", ucpx + ucpw/2, ucpy);
    bval ? (
      uk == 0 ? (
        abs(bbal) < 0.25 ? strcpy(#ugv, "Centered") : abs(bbal) > 60 ? strcpy(#ugv, bbal > 0 ? "Left only" : "Right only") : sprintf(#ugv, "%s %.1f dB", bbal > 0 ? "L" : "R", abs(bbal));
        ugf = max(-1, min(1, bbal/12));
      ) : (
        sprintf(#ugv, "S/M %.1f dB", max(-60, bwid));
        ugf = max(0, min(1, (bwid+40)/46));
      );
    ) : (
      strcpy(#ugv, "--"); ugf = uk == 0 ? 0 : -1;
    );
    gfx_setfont(5); ucol(ucTEXT, 1); utc(#ugv, ucpx + ucpw/2, ucpy + 20*usc);
    ucby = floor(ucpy + 38*usc); ucbh = floor(8*usc);
    ubox(ucpx, ucby, ucpw, ucbh, 4*usc);
    ucol(ucACC, 1);
    uk == 0 ? (
      ugf > 0 ? urr(floor(ucpx + ucpw/2*(1-ugf)), ucby, floor(ucpw/2*ugf), ucbh, 4*usc, 1)
              : ugf < 0 ? urr(floor(ucpx + ucpw/2), ucby, floor(-ucpw/2*ugf), ucbh, 4*usc, 1);
      ucol(ucDIM, 1); gfx_rect(floor(ucpx + ucpw/2), ucby - 2*usc, 1, ucbh + 4*usc);
    ) : (
      ugf > 0 ? urr(ucpx, ucby, floor(ucpw*ugf), ucbh, 4*usc, 1);
      ucol(ucDIM, 1); gfx_rect(floor(ucpx + ucpw*40/46), ucby - 2*usc, 1, ucbh + 4*usc);   // 0 dB: side as loud as mid
    );
    gfx_setfont(8); ucol(ucDIM, 1);
    ulc(uk == 0 ? "L" : "mono", ucpx, ucby + ucbh + 9*usc);
    urc(uk == 0 ? "R" : "wide", ucpx + ucpw, ucby + ucbh + 9*usc);
    uin(ucpx, ucpy - 10*usc, ucpw, 76*usc) ? ( uhov = 23 + uk; );
    uk += 1;
  );
);

uloud ? (
  // ---- loudness: the history graph on the left (time runs left to right, now at the right edge),
  //      the readings and the verdict in a narrow column on the right
  lp = floor(slider10+0.5);
  lt = ltgt(lp); ltl = ltol(lp); ltpm = ltpl(lp);
  llo = lt - 26; lhi = lt + 6;          // the scale: the target sits at 80 % of the height
  lmeas2 = lmeas && !ufrz;
  ldv = ux(452) + uwp;                   // the divider: the graph gets all extra width
  lgx0 = ux(62); lgx1 = ldv - 104*usc; lgw = lgx1 - lgx0;
  lgy0 = uy(92); lgy1 = uy(306+uex); lgh = lgy1 - lgy0;

  // grid every 10 LU, the tolerance as a mint band, the target as a mint line
  ucol(umix(ucP, ucMINT, udark ? 0.10 : 0.12), 1);
  gfx_rect(lgx0, lgmap(lt + ltl), lgw, max(1, lgmap(lt - ltl) - lgmap(lt + ltl)));
  gfx_setfont(3);
  ulv = ceil((llo + 0.01)/10)*10;
  loop(4,
    ulv < lhi - 0.5 ? (
      ucol(ucGRID, 1); gfx_rect(lgx0, lgmap(ulv), lgw, 1);
      abs(ulv - lt) > 2.5 ? ( sprintf(#ulab, "%d", ulv); ucol(ucDIM, 1); urc(#ulab, lgx0 - 6*usc, lgmap(ulv)); );
    );
    ulv += 10;
  );
  uk = 1;
  loop(3, ucol(ucGRID, 1); gfx_rect(floor(lgx0 + lgw*uk/4), lgy0, 1, lgh); uk += 1; );
  ucol(ucMINT, 1); gfx_rect(lgx0, floor(lgmap(lt) - 0.7*usc), lgw, max(1, floor(1.4*usc)));
  sprintf(#ulab, "%d", lt); urc(#ulab, lgx0 - 6*usc, lgmap(lt));
  ucol(ucLINE, 1); gfx_rect(lgx0, lgy1, lgw, 1);

  // the history: 360 steps, the oldest on the left. Filled softly, with a clean line on top in the color
  // of each moment (mint on target, amber and red louder, blue quieter). The line runs straight from step to step.
  lkc = lrk;
  uk = 0;
  loop(360,
    lk = (lkc + 1 + uk) % 360;
    m_wrr[uk] = (lkc >= 0 && m_wdn[lk] > 0 && m_wde[lk] > 0) ? lgmap(-0.691 + 10*log10(m_wde[lk]/m_wdn[lk])) : -1;
    uk += 1;
  );
  lcw = lgw/360;
  uk = 0;
  loop(360,
    lyy = m_wrr[uk];
    lyy >= 0 ? (
      lk = (lkc + 1 + uk) % 360;
      lyl = (uk > 0 && m_wrr[uk-1] >= 0) ? (lyy + m_wrr[uk-1])/2 : lyy;
      lyn = (uk < 359 && m_wrr[uk+1] >= 0) ? m_wrr[uk+1] : lyy;
      lyr = (lyy + lyn)/2;
      lc = lcolr(-0.691 + 10*log10(m_wde[lk]/m_wdn[lk]), lt, ltl);
      lx0 = lgx0 + uk*lcw; lxm = lx0 + lcw/2; lx1 = lx0 + lcw;
      lx2 = uk < 359 ? lx1 + max(1, 0.3*lcw) : lx1; lye = lyr + (lyn - lyr)*min(1, (lx2 - lx1)/max(0.0001, 0.5*lcw));   // a pixel over the next step: no seams
      ucol(umix(ucP, lc, udark ? 0.32 : 0.30), 1);
      gfx_triangle(lx0, lgy1, lx0, lyl, lxm, lyy, lx1, lyr, lx2, lye, lx2, lgy1);
      ucol(lc, 1);
      uquad(lx0, lyl, lxm, lyy, 1.6*usc); uquad(lxm, lyy, lx1, lyr, 1.6*usc);
    );
    uk += 1;
  );
  // the integrated loudness as a thin line across
  lint > -70 && lint > llo && lint < lhi ? (
    ucol(ucTEXT, 0.55); gfx_rect(lgx0, lgmap(lint), lgw, 1);
  );
  // time: the span on the left, now on the right
  gfx_setfont(3); ucol(ucDIM, 1);
  strcpy(#ulab, slider12 < 0.5 ? "-1 min" : slider12 < 1.5 ? "-5 min" : slider12 < 2.5 ? "-15 min" : slider12 < 3.5 ? "-30 min" :
                slider12 < 4.5 ? "-1 h" : slider12 < 5.5 ? "-2 h" : "-5 h");
  ulc(#ulab, lgx0, lgy1 + 10*usc);
  urc("now", lgx1, lgy1 + 10*usc);
  uin(lgx0, lgy0, lgw, lgh) ? uhov = 59;

  // meters right of the graph: loudness (M momentary, S short-term) on the graph's scale,
  // then the peak meters (L, R, true peak, dBFS) on their own scale
  lmbw = 7*usc;
  uk = 0;
  loop(2,
    lmbx = lgx1 + (14 + uk*12)*usc;
    lv = uk == 0 ? lmom : lst;
    ubox(lmbx, lgy0, lmbw, lgh, 3*usc);
    lv > llo ? (
      lmy = lgmap(lv);
      ucol(lcolr(lv, lt, ltl), lmeas2 ? 1 : 0.5); urr(lmbx, lmy, lmbw, lgy1 - lmy, 3*usc, 1);
    );
    ucol(ucMINT, 1); gfx_rect(lmbx - 1*usc, floor(lgmap(lt) - 0.7*usc), lmbw + 2*usc, max(1, floor(1.4*usc)));
    gfx_setfont(16); ucol(ucDIM, 1); utc(uk == 0 ? "M" : "S", lmbx + lmbw/2, lgy1 + 10*usc);
    uin(lmbx - 3*usc, lgy0, lmbw + 6*usc, lgh) ? uhov = 80 + uk;
    uk += 1;
  );
  // peaks: what came since the last frame, falling back 20 dB per second, the highest held for 2 s
  upkt = uft/30;
  uk = 0;
  loop(2,
    upv = uk == 0 ? lpkl : lpkr;
    uk == 0 ? lpkl = 0 : lpkr = 0;
    upd2 = upv > 0.000001 ? 20*log10(upv) : -120;
    upk = uk == 0 ? upkl : upkr; uph = uk == 0 ? uphl : uphr; upt2 = uk == 0 ? upthl : upthr;
    !ufrz ? (
      upk = max(upd2, upk - 20*upkt);
      upd2 >= uph ? ( uph = upd2; upt2 = 0; ) : ( upt2 += upkt; upt2 > 2 ? uph = max(upk, uph - 20*upkt); );
    );
    uk == 0 ? ( upkl = upk; uphl = uph; upthl = upt2; ) : ( upkr = upk; uphr = uph; upthr = upt2; );
    lmbx = lgx1 + (46 + uk*10)*usc;
    ubox(lmbx, lgy0, lmbw, lgh, 3*usc);
    upk > -60 ? (
      lmy = floor(lgy1 - lgh*min(1, (upk + 60)/60));
      ucol(upk > ltpm ? ucRED : upk > ltpm - 6 ? ucWARN : ucMINT, 1); urr(lmbx, lmy, lmbw, lgy1 - lmy, 3*usc, 1);
    );
    uph > -60 ? ( ucol(uph > ltpm ? ucRED : ucTEXT, 0.9); gfx_rect(lmbx, floor(lgy1 - lgh*min(1, (uph + 60)/60)), lmbw, max(1, floor(1.5*usc))); );
    gfx_setfont(16); ucol(ucDIM, 1); utc(uk == 0 ? "L" : "R", lmbx + lmbw/2, lgy1 + 10*usc);
    uin(lmbx - 2*usc, lgy0, lmbw + 4*usc, lgh) ? uhov = 87;
    uk += 1;
  );
  // the peak scale, right of the peak meters
  gfx_setfont(16); ucol(ucDIM, 1);
  uk = 0;
  loop(6,
    uv = uk == 0 ? 0 : uk == 1 ? -6 : uk == 2 ? -12 : uk == 3 ? -24 : uk == 4 ? -36 : -48;
    sprintf(#ulab, "%d", uv);
    urc(#ulab, ldv - 8*usc, floor(lgy1 - lgh*(uv + 60)/60));
    uk += 1;
  );
  // history span, top left
  ulrx = ux(26); ulry = uy(62); ulrw = 54*usc; ulrh = 18*usc;
  uin(ulrx, ulry, ulrw, ulrh) ? uhov = 58;
  strcpy(#ulab, slider12 < 0.5 ? "1 min" : slider12 < 1.5 ? "5 min" : slider12 < 2.5 ? "15 min" : slider12 < 3.5 ? "30 min" :
                slider12 < 4.5 ? "1 h" : slider12 < 5.5 ? "2 h" : "5 h");
  udrop(ulrx, ulry, ulrw, ulrh, uhov == 58 || udd == 1, #ulab, 8);

  // readings, right of a divider, compact
  ucol(ucLINE, 1); gfx_rect(ldv, uy(66), 1, (258+uex)*usc);
  lxl = ldv + 12*usc; lxr = ux(652) + uwp;
  lxv = lxr - 42*usc;
  uk = 0;
  loop(6,
    lry = uy(76 + uk*20);
    uin(lxl, lry - 10*usc, lxr - lxl, 20*usc) ? uhov = 80 + uk;
    gfx_setfont(8); ucol(ucMUTED, 1);
    ulc(uk == 0 ? "Momentary" : uk == 1 ? "Short-term" : uk == 2 ? "Integrated" : uk == 3 ? "Loudness range" : uk == 4 ? "True peak max" : "Timecode", lxl, lry);
    uk < 5 ? (
      lv = uk == 0 ? lmom : uk == 1 ? lst : uk == 2 ? lint : uk == 3 ? llra : (ltpk > 0 ? 20*log10(ltpk) : -200);
      uk == 3 ? ( lv >= 0 ? sprintf(#ulab, "%.1f", lv) : strcpy(#ulab, "--"); )
              : ( lv > (uk == 4 ? -120 : -70) ? sprintf(#ulab, "%.1f", lv) : strcpy(#ulab, "--"); );
      gfx_setfont(4); ucol(uk <= 1 && !lmeas2 ? ucMUTED : ucTEXT, 1); urc(#ulab, lxv, lry);
      gfx_setfont(10); ucol(ucDIM, 1); ulc(uk == 3 ? "LU" : uk == 4 ? "dBTP" : "LUFS", lxv + 4*usc, lry + 0.5*usc);
      lc = uk == 2 ? lvcol(lv, lt, ltl, lp) : uk <= 1 ? lcolr(lv, lt, ltl) : uk == 3 ? (llra < 0 ? ucDIM : llra > (lp == 1 ? 20 : 15) ? ucWARN : ucMINT)
                                                  : (ltpk <= 0 ? ucDIM : lv > ltpm ? ucRED : ucMINT);
      ucol(lc, 1); gfx_circle(lxr - 4*usc, lry, 3*usc, 1, 1);
    ) : (
      // the DAW position as timecode, 25 frames per second (without the DAW's own start offset)
      ltcv = play_position; ltcf = floor(abs(ltcv)*25 + 0.0001);
      sprintf(#ultc, "%s%02d:%02d:%02d:%02d", ltcv < 0 ? "-" : "", floor(ltcf/90000), floor(ltcf/1500) % 60, floor(ltcf/25) % 60, ltcf % 25);
      gfx_setfont(13); ucol(ucBLUE, 1); urc(#ultc, lxr, lry);
    );
    uk += 1;
  );

  // the verdict: three lines that say what the numbers mean for the chosen target
  strcpy(#lpn, lp == 0 ? "EBU R128" : lp == 1 ? "Netflix" : lp == 2 ? "Spotify" : lp == 3 ? "YouTube" : lp == 4 ? "Apple Music" : "Tidal");
  lcy0 = uy(194); lch = (130+uex)*usc;
  ubox(lxl, lcy0, lxr - lxl, lch, 10*usc);
  uin(lxl, lcy0, lxr - lxl, lch) ? uhov = 86;
  uk = 0;
  loop(3,
    lry = lcy0 + (17 + uk*40)*usc;
    uk == 0 ? (
      lint <= -70 ? (
        lc = ucDIM; strcpy(#lh, "Waiting for audio");
        strcpy(#ld, lmeas2 ? "measuring ..." : slider11 >= 0.5 ? "starts when the DAW plays" : "no signal yet");
      ) : (
        ldev = lint - lt;
        abs(ldev) <= ltl ? (
          lc = ucMINT; strcpy(#lh, "On target");
          sprintf(#ld, "%+.1f LU from %s (%d ±%s)", ldev, #lpn, lt, ltl < 1 ? "0.5" : ltl < 1.5 ? "1" : "2");
        ) : lp >= 2 ? (
          ldev > 0 ? ( lc = ucWARN; strcpy(#lh, "Turned down"); sprintf(#ld, "%s plays it %.1f dB quieter", #lpn, ldev); )
                   : ( lc = ucBLUE; strcpy(#lh, "Below target"); sprintf(#ld, "%.1f LU under %d, may sound quiet", -ldev, lt); );
        ) : (
          lc = ucRED;
          ldev > 0 ? ( strcpy(#lh, "Too loud"); sprintf(#ld, "%.1f LU over %d, turn down %.1f dB", ldev, lt, ldev); )
                   : ( strcpy(#lh, "Too quiet"); sprintf(#ld, "%.1f LU under %d, turn up %.1f dB", -ldev, lt, -ldev); );
        );
      );
    ) : uk == 1 ? (
      ltpk <= 0.000001 ? ( lc = ucDIM; strcpy(#lh, "True peak"); strcpy(#ld, "no signal yet"); ) : (
        ltpd = 20*log10(ltpk);
        ltpd > ltpm ? ( lc = ucRED; strcpy(#lh, "True peak too high"); sprintf(#ld, "%.1f dBTP, %s allows %d", ltpd, #lpn, ltpm); )
                    : ( lc = ucMINT; strcpy(#lh, "True peak OK"); sprintf(#ld, "%.1f dBTP, limit %d", ltpd, ltpm); );
      );
    ) : (
      llra < 0 ? ( lc = ucDIM; strcpy(#lh, "Loudness range"); strcpy(#ld, "needs a few seconds"); ) :
      llra > (lp == 1 ? 20 : 15) ? ( lc = ucWARN; strcpy(#lh, "Wide loudness range"); sprintf(#ld, "%.1f LU, quiet parts may get lost", llra); ) :
      ( lc = ucMINT; strcpy(#lh, "Loudness range");
        sprintf(#ld, "%.1f LU, %s", llra, llra < 4 ? "very even" : llra < 8 ? "even" : lp == 1 ? "fine for film" : "natural dynamics"); );
    );
    ucol(lc, 1); gfx_circle(lxl + 13*usc, lry, 3*usc, 1, 1);
    gfx_setfont(7); ucol(ucTEXT, 1); ulc(#lh, lxl + 23*usc, lry);
    gfx_setfont(10); ucol(ucMUTED, 1); ulc(#ld, lxl + 23*usc, lry + 14*usc);
    uk += 1;
  );
);

// switched off: a small label at the top of the display
ufrz ? (
  // loudness: next to the history span; goniometer: top left; bars: top center
  upsx = uloud ? ux(86) : ugon ? ux(26) : udx + udw/2 - 32*usc;
  gfx_setfont(6);
  ucol(ucACC, 1); urr(upsx, uy(62), 64*usc, 18*usc, 9*usc, 1);
  ucol(ucACCT, 1); utc("Paused", upsx + 32*usc, uy(71));
);

// ---- total: the full signal on one classic bar
umy = uy(347+uex); umh = 10*usc; umx = ux(54); umw = (562+uwx)*usc;
gfx_setfont(7); ucol(ucMUTED, 1); ulc("Total", ux(16), umy + umh/2);
ubox(umx, umy, umw, umh, 5*usc);
umc = floor(umx + umw/2);
bval ? (
  uxv = floor(umx + umw*(bcor+1)/2);
  ucorr(bcor, 1);
  bcor >= 0 ? urr(umc, umy, max(umh, uxv-umc+umh/2), umh, 5*usc, 1) : urr(min(uxv-umh/2, umc-umh), umy, max(umh, umc-uxv+umh/2), umh, 5*usc, 1);
  (slider5 >= 0.5 && bhld < bcor - 0.02) ? (
    ucol(ucTEXT, 0.85); gfx_rect(floor(umx + umw*(bhld+1)/2), umy - 2*usc, max(1, floor(1.5*usc)), umh + 4*usc);
  );
);
ucol(ucDIM, 1); gfx_rect(umc, umy - 2*usc, 1, umh + 4*usc);
gfx_setfont(4);
bval ? usign(#utot, bcor) : strcpy(#utot, "--");
ucol(ucTEXT, 1); urc(#utot, ux(664) + uwp, umy + umh/2);
uin(ux(16), umy - 4*usc, (648+uwx)*usc, umh + 8*usc) ? uhov = 21;

// ---- controls panel
ucy = uy(366+uex); uch = 104*usc;
ucol(ucP, 1); urr(udx, ucy, udw, uch, 10*usc, 1);
ucol(ucLINE, 1); urr(udx, ucy, udw, uch, 10*usc, 0);
ulby = uy(382+uex);                      // column labels
uby2 = uy(407+uex); ubh2 = 22*usc;       // buttons
unty = uy(454+uex);                      // notes under the controls
uloud ? (
  // target presets
  uk = 0;
  loop(6,
    usx = ux(28 + uk*70);
    uin(usx, uby2, 64*usc, ubh2) ? uhov = 50 + uk;
    ubtn(usx, uby2, 64*usc, ubh2, lp == uk, uhov == 50 + uk,
         uk == 0 ? "EBU R128" : uk == 1 ? "Netflix" : uk == 2 ? "Spotify" : uk == 3 ? "YouTube" : uk == 4 ? "Apple Music" : "Tidal");
    uk += 1;
  );
  gfx_setfont(7); ucol(ucMUTED, 1); utc("Target", ux(235), ulby);
  gfx_setfont(9); ucol(ucTEXT, 1);
  utc(lp == 0 ? "-23 LUFS ±0.5 LU  ·  true peak -1 dBTP" :
      lp == 1 ? "-27 LKFS ±2 LU  ·  true peak -2 dBTP  ·  full mix, not dialog-gated" :
      lp == 2 ? "Plays at -14 LUFS  ·  true peak -1 dBTP" :
      lp == 3 ? "Plays at -14 LUFS  ·  true peak -1 dBTP" :
      lp == 4 ? "Plays at -16 LUFS  ·  true peak -1 dBTP" :
                "Plays at -14 LUFS  ·  true peak -1 dBTP", ux(235), unty);
  // measure: Always / Playback / Timecode
  urfx = ux(466) + floor(uwp*3/4); urfw = 80*usc;
  gfx_setfont(7); ucol(ucMUTED, 1); utc("Measure", urfx + urfw/2, ulby);
  uin(urfx, uby2, urfw, ubh2) ? uhov = 56;
  udrop(urfx, uby2, urfw, ubh2, uhov == 56 || udd == 2, slider11 < 0.5 ? "Always" : slider11 < 1.5 ? "Playback" : "Timecode", 9);
  gfx_setfont(8); ucol(ucMUTED, 1);
  utc(slider11 < 0.5 ? "all the time" : slider11 < 1.5 ? "while the DAW plays" : "by DAW position", urfx + urfw/2, unty);
  // measurement: reset, and how much is measured
  uhx = ux(572) + uwp; uhw = 80*usc;
  gfx_setfont(7); ucol(ucMUTED, 1); utc("Measurement", uhx + uhw/2, ulby);
  uin(uhx, uby2, uhw, ubh2) ? uhov = 57;
  ubtn(uhx, uby2, uhw, ubh2, 0, uhov == 57, "Reset");
  lsec = floor(lnsl/10);
  lsec >= 3600 ? sprintf(#ulab, "%d:%02d:%02d measured", floor(lsec/3600), floor(lsec/60) % 60, lsec % 60)
               : sprintf(#ulab, "%d:%02d measured", floor(lsec/60), lsec % 60);
  gfx_setfont(8); ucol(ucMUTED, 1); utc(#ulab, uhx + uhw/2, unty);
) : (
  // Bands, Averaging, Offset, Reference, Hold. The goniometer page shows only what acts on it.
  uky = uy(418+uex); ukr = 17*usc;
  unbs = m_bl[max(0, min(9, floor(slider1+0.5)))];
  usel = udrag == 2 || (uhov == 1 && (mouse_cap & 16));   // Alt on Bands: selectivity
  usel ? sprintf(#uv1, "Sel. %d %%", floor(slider2+0.5)) : sprintf(#uv1, "%d", unbs);
  slider3 < 1000 ? sprintf(#uv3, "%d ms", floor(slider3+0.5)) : sprintf(#uv3, "%.1f s", slider3/1000);
  !ugon ? uknob(1, ux(80), uky, ukr, usel ? ufrac(2) : ufrac(1), "Bands", #uv1);
  uknob(3, ux(190) + floor(uwp/4), uky, ukr, ufrac(3), "Averaging", #uv3);

  // offset: info only, the audio is never moved
  uofx = ux(272) + floor(uwp/2); uofw = 140*usc; uofy = uy(396+uex); uofh = 46*usc;
  gfx_setfont(7); ucol(ucMUTED, 1); utc("Offset", uofx+uofw/2, ulby);
  ubox(uofx, uofy, uofw, uofh, 8*usc);
  uin(uofx, uofy, uofw, uofh+20*usc) ? uhov = 34;
  ofs_ok ? (
    uoms = abs(ofs_lag)/srate*1000;
    sprintf(#uo1, uoms < 0.995 ? "%.2f ms" : uoms < 9.95 ? "%.1f ms" : "%.0f ms", uoms);
    uosm = floor(abs(ofs_lag)+0.5);
    uosm == 0 ? strcpy(#uo2, "0 samples · in time") :
      sprintf(#uo2, "%d %s · %s", uosm, uosm == 1 ? "sample" : "samples",
              ofs_lag < 0 ? (inm ? "sidechain is late" : "right is late") : (inm ? "main is late" : "left is late"));
  ) : (
    strcpy(#uo1, "--");
    strcpy(#uo2, bval ? "no clear offset" : "no signal to compare");
  );
  gfx_setfont(5); ucol(ofs_ok ? ucTEXT : ucDIM, 1); utc(#uo1, uofx+uofw/2, uofy + 16*usc);
  gfx_setfont(8); ucol(ucMUTED, 1); utc(#uo2, uofx+uofw/2, uofy + 35*usc);
  ofs_ok ? (
    ofs_sgn < 0 ? (
      ucol(ucRED, 1); urr(uofx+uofw/2 - 52*usc, unty - 8*usc, 104*usc, 16*usc, 8*usc, 1);
      gfx_setfont(7); ucol(udark ? ucBG : 0xFFFFFF, 1); utc("Polarity flipped", uofx+uofw/2, unty);
    ) : (
      gfx_setfont(9); ucol(ucMINT, 1); utc("Polarity OK", uofx+uofw/2, unty);
    );
  );

  // reference: capture the current curve as a line, click again to clear it (not on the goniometer page)
  !ugon ? (
    urfx = ux(466) + floor(uwp*3/4); urfw = 80*usc;
    gfx_setfont(7); ucol(ucMUTED, 1); utc("Reference", urfx+urfw/2, ulby);
    uin(urfx, uby2, urfw, ubh2) ? uhov = 33;
    ubtn(urfx, uby2, urfw, ubh2, refon, uhov == 33, refon ? "Clear" : "Capture");
  );

  // hold lows: click: off / 3 s. Shift-click: infinite.
  uhx = ux(572) + uwp; uhw = 80*usc;
  gfx_setfont(7); ucol(ucMUTED, 1); utc("Hold lows", uhx+uhw/2, ulby);
  uin(uhx, uby2, uhw, ubh2) ? uhov = 4;
  ubtn(uhx, uby2, uhw, ubh2, slider5 >= 0.5, uhov == 4, slider5 < 0.5 ? "Off" : slider5 < 1.5 ? "3 s" : "Infinite");

  // reset: a quiet text button under Hold lows
  uin(uhx, unty - 9*usc, uhw, 18*usc) ? uhov = 14;
  gfx_setfont(8); ucol(uhov == 14 ? ucTEXT : ucDIM, 1); utc("Reset plugin", uhx+uhw/2, unty);
);

// ---- dropdown lists (over everything below them)
udd ? (
  udn = udd == 1 ? 7 : 3;
  udsel = udd == 1 ? floor(slider12+0.5) : floor(slider11+0.5);
  udlx = udd == 1 ? ulrx : urfx; udlw = udd == 1 ? 72*usc : urfw;
  udly = udd == 1 ? ulry + ulrh + 4*usc : uby2 - (udn*20 + 8)*usc - 4*usc;   // the measure list opens upward
  udlh = (udn*20 + 8)*usc;
  ucol(ucP, 1); urr(udlx, udly, udlw, udlh, 8*usc, 1);
  ucol(ucLINE, 1); urr(udlx, udly, udlw, udlh, 8*usc, 0);
  uin(udlx, udly, udlw, udlh) ? uhov = 69;
  uk = 0;
  loop(udn,
    uiy = udly + (4 + uk*20)*usc;
    uin(udlx, uiy, udlw, 20*usc) ? uhov = 70 + uk;
    uhov == 70 + uk ? ( ucol(ucHOV, 1); urr(udlx + 4*usc, uiy, udlw - 8*usc, 20*usc, 6*usc, 1); );
    udd == 1 ? strcpy(#ulab, uk == 0 ? "1 min" : uk == 1 ? "5 min" : uk == 2 ? "15 min" : uk == 3 ? "30 min" : uk == 4 ? "1 h" : uk == 5 ? "2 h" : "5 h")
             : strcpy(#ulab, uk == 0 ? "Always" : uk == 1 ? "Playback" : "Timecode");
    uk == udsel ? ( gfx_setfont(6); ucol(ucACC, 1); ) : ( gfx_setfont(9); ucol(ucTEXT, 1); );
    ulc(#ulab, udlx + 12*usc, uiy + 10*usc);
    uk += 1;
  );
);

// ---- help panel: over the display, a short guide and "Read Manual" (opens the manual on dmajorsound.com)
uhelp && gfx_getchar(27) ? uhelp = 0;   // Esc closes it
uhelp ? (
  uhpw = floor(min(560*usc, udw - 24*usc)); uhph = floor(min(262*usc, udh - 16*usc));
  uhpx = floor(udx + (udw - uhpw)/2); uhpy = floor(udy + (udh - uhph)/2);
  uin(uhpx, uhpy, uhpw, uhph) ? uhov = 43;
  ubox(uhpx, uhpy, uhpw, uhph, 10*usc);
  ucol(ucLINE, 1); urr(uhpx, uhpy, uhpw, uhph, 10*usc, 0);
  gfx_setfont(14); ucol(ucTEXT, 1); ulc("Binocular - Help", uhpx + 20*usc, uhpy + 26*usc);
  // close (x), top right of the panel
  uin(uhpx + uhpw - 34*usc, uhpy + 12*usc, 26*usc, 26*usc) ? uhov = 44;
  ucol(uhov == 44 ? ucTEXT : ucMUTED, 1);
  uquad(uhpx + uhpw - 27*usc, uhpy + 19*usc, uhpx + uhpw - 15*usc, uhpy + 31*usc, 1.4*usc);
  uquad(uhpx + uhpw - 15*usc, uhpy + 19*usc, uhpx + uhpw - 27*usc, uhpy + 31*usc, 1.4*usc);
  gfx_setfont(9); uhl = uhpy + 56*usc; ucol(ucTEXT, 1);
  ulc("Correlation: how left and right relate in each band. +1 in phase, 0 unrelated, -1 out of phase.", uhpx + 20*usc, uhl); uhl += 22*usc;
  ulc("Mono loss: how many dB each band drops when the sides are summed to mono.", uhpx + 20*usc, uhl); uhl += 22*usc;
  ulc("Goniometer: the stereo image as a trace, the correlation of the full signal below.", uhpx + 20*usc, uhl); uhl += 22*usc;
  ulc("Loudness: momentary, short-term, integrated, range and true peak against a target. The graph", uhpx + 20*usc, uhl); uhl += 16*usc;
  ulc("shows the history, as much time as set top left. Timecode measures by the DAW position.", uhpx + 20*usc, uhl); uhl += 22*usc;
  ulc("Stereo compares left and right. Sidechain compares this track with inputs 3/4.", uhpx + 20*usc, uhl); uhl += 22*usc;
  ucol(ucMUTED, 1); ulc("Move the mouse over any control: its explanation shows at the bottom left.", uhpx + 20*usc, uhl);
  // Read Manual
  umbw = floor(120*usc); umbh = floor(24*usc); umbx = floor(uhpx + uhpw - umbw - 20*usc); umby = floor(uhpy + uhph - umbh - 16*usc);
  uin(umbx, umby, umbw, umbh) ? uhov = 42;
  ucol(uhov == 42 ? umix(ucACC, 0xFFFFFF, 0.25) : ucACC, 1); urr(umbx, umby, umbw, umbh, umbh/2, 1);
  gfx_setfont(6); ucol(ucACCT, 1); utc("Read Manual", umbx + umbw/2, umby + umbh/2);
);

// ---- footer: the same in every dmajorsound plugin
ucol(ucLINE, 1); gfx_rect(ux(16), uy(496+uex), (648+uwx)*usc, 1);
ufcy = uy(508+uex);
gfx_setfont(8); ucol(ucDIM, 1);
ulc("V 1.2.0 - developed with AI assistance", ux(16), ufcy);
// footer right: the dmajorsound mark in the corner, dmajorsound.com to its left
gfx_measurestr("dmajorsound.com", uftw, ufth);
ucol(ucMUTED, 1); ulogo(ux(656) + uwp, ufcy); gfx_a = 1;   // clear of the window resize corner
ucol(ucDIM, 1); urc("dmajorsound.com", ux(656) + uwp - (usc >= 1.5 ? lgw2 : lgw1) - 8*usc, ufcy);

// a newer Binocular (as in OLAAF 0.8.7), right-aligned left of dmajorsound.com, a light red dot:
//   "x.y.z is out" (blinks) - click downloads and installs; "Downloading x.y.z ... 42%" (a ring);
//   "x.y.z downloaded" - click installs; "Download failed" - click tries again. Right-click: the menu.
// The plug-in sets updv (version), upst (0 idle, 1 downloading, 2 there, 3 failed), uppr (0..1 or -1),
// upas (1: an installer for this system is on GitHub) and uperr (why it failed).
updv > 0 ? (
  sprintf(#uupv, "%d.%d.%d", floor(updv/10000), floor(updv/100)%100, updv%100);
  upst == 1 ? ( uppr >= 0 ? sprintf(#uupd, "Downloading %s … %d%%", #uupv, floor(uppr*100+0.5)) : sprintf(#uupd, "Downloading %s …", #uupv); ) :
  upst == 2 ? sprintf(#uupd, "%s downloaded", #uupv) :
  upst == 3 ? strcpy(#uupd, "Download failed") :
  sprintf(#uupd, "%s is out", #uupv);
  gfx_measurestr(#uupd, uupw, uuph);
  uupr = ux(656) + uwp - (usc >= 1.5 ? lgw2 : lgw1) - 8*usc - uftw - 16*usc;   // right edge of the note
  uupx = floor(uupr - uupw - 11*usc);
  uin(uupx - 4*usc, ufcy - 9*usc, uupw + 19*usc, 18*usc) ? uhov = 40;
  ucol(0xF06E6E, 1);
  upst == 1 ? (
    gfx_circle(uupx + 3.5*usc, ufcy, 3.5*usc, uppr >= 0.5, 1);   // downloading: a ring that fills up
  ) : upst == 2 || upst == 3 ? (
    gfx_circle(uupx + 3.5*usc, ufcy, 3.5*usc, 1, 1);             // there or failed: a full dot, no blinking
  ) : (
    gfx_circle(uupx + 3.5*usc, ufcy, 3.5*usc, floor(time_precise()/0.7) % 2 == 0, 1);   // blinks every 0.7 s
  );
  ucol(slider7 ? 0xC8423B : 0xFF7A6E, 1);
  ulc(#uupd, uupx + 11*usc, ufcy);
);

// ---- status line, above the footer line: explains whatever is under the mouse
gfx_setfont(9); ucol(ucTEXT, 1);
ustx = ux(16); usty = uy(483+uex);
uhov == 1 ? ulc(usel ? "Selectivity (Alt-drag): higher makes each band narrower and sharper, lower blends neighbors."
                     : "Bands: how many frequency bands the meter splits the signal into. Alt-drag sets the selectivity.", ustx, usty) :
uhov == 3 ? ulc("Averaging: mids and highs need at least 0.1 s, the bass about 0.3 s.", ustx, usty) :
uhov == 4 ? ulc("Hold lows: keeps the lowest reading of each band for 3 s. Shift-click holds until you click the display.", ustx, usty) :
uhov == 10 ? ulc(ufrz ? "Off: the meter shows its last picture. Click to switch it on." : "On: the meter runs. Off keeps the last picture to read it. The audio always passes untouched.", ustx, usty) :
uhov == 11 ? ulc("Stereo: compares left and right of this track.", ustx, usty) :
uhov == 12 ? ulc("Sidechain: compares this track (inputs 1/2) with inputs 3/4, e.g. boom vs. lav. Loudness stays on 1/2.", ustx, usty) :
uhov == 13 ? ulc(udark ? "Dark mode. Click for light." : "Light mode. Click for dark.", ustx, usty) :
uhov == 41 ? ulc(uhelp ? "Help: click to close it." : "Help: a short guide and the manual.", ustx, usty) :
uhov == 42 ? ulc("Read Manual: opens the Binocular manual on dmajorsound.com in your browser.", ustx, usty) :
uhov == 43 ? ulc("Esc or the x closes the help.", ustx, usty) :
uhov == 44 ? ulc("Close the help.", ustx, usty) :
uhov == 40 ? (
  upst == 1 ? sprintf(#uupt, "Binocular %s is coming from GitHub into your download folder.", #uupv) :
  upst == 2 ? sprintf(#uupt, "Binocular %s is in your download folder. Click to install it (quit your DAW before you click Install). Right-click for more.", #uupv) :
  upst == 3 ? (
    sprintf(#uupt, "Binocular %s could not be downloaded (%s). Click to try again, right-click to open the page instead.", #uupv,
      uperr == 1 ? "no connection" : uperr == 2 ? "GitHub answered with an error" : uperr == 3 ? "nothing came for 30 seconds" :
      uperr == 4 ? "it arrived incomplete" : uperr == 5 ? "the download folder cannot be written to" : "unknown");
  ) :
  upas ? sprintf(#uupt, "Binocular %s is out. Click to download and install it. Right-click: download only, the download folder, what's new.", #uupv)
       : sprintf(#uupt, "Binocular %s is out. Click to open the download page.", #uupv);
  ulc(#uupt, ustx, usty);
) :
uhov == 14 ? ulc("Reset plugin: every setting back to its default, holds, reference and loudness cleared.", ustx, usty) :
uhov == 30 ? ulc("Correlation: +1 in phase, 0 unrelated, -1 out of phase.", ustx, usty) :
uhov == 31 ? ulc("Mono loss: how many dB each band drops when the two sides are summed to mono.", ustx, usty) :
uhov == 35 ? ulc("Goniometer: the stereo image as a trace. Correlation stays below.", ustx, usty) :
uhov == 36 ? ulc("Loudness: momentary, short-term, integrated, range and true peak, with a graph of the history.", ustx, usty) :
uhov == 22 ? ulc("Upright line: mono. Lying flat: out of phase. Round cloud: wide and unrelated. Leaning: one side louder.", ustx, usty) :
uhov == 23 ? ulc("Balance: how much louder one side is than the other.", ustx, usty) :
uhov == 24 ? ulc("Width: side against mid. Very low is mono, around 0 dB is very wide, above 0 dB the sides work against each other.", ustx, usty) :
uhov == 32 ? ulc("Range: how deep the mono loss scale reaches. Click for 24, 48 or 96 dB.", ustx, usty) :
uhov == 33 ? ulc(refon ? "Reference: click to clear the line." : "Reference: keeps the current curve as a line, to compare before and after.", ustx, usty) :
uhov == 34 ? ulc("Offset: the time shift between the two sides, found across the spectrum. Info only, the audio is not moved.", ustx, usty) :
(uhov >= 50 && uhov <= 55) ? (
  ulc(uhov == 50 ? "EBU R128: European broadcast, -23 LUFS integrated within ±0.5 LU, true peak at most -1 dBTP." :
      uhov == 51 ? "Netflix: -27 LKFS ±2 LU, true peak -2 dBTP. Netflix gates on dialog; this meter measures the full mix." :
      uhov == 52 ? "Spotify: plays everything at about -14 LUFS. Louder masters are turned down." :
      uhov == 53 ? "YouTube: plays at about -14 LUFS. Louder uploads are turned down, quieter ones stay quiet." :
      uhov == 54 ? "Apple Music: Sound Check plays at about -16 LUFS." :
                   "Tidal: plays at about -14 LUFS. Louder masters are turned down.", ustx, usty);
) :
uhov == 56 || (uhov >= 70 && uhov <= 72 && udd == 2) ? ulc("Measure: Always (everything that comes in), Playback (only while the DAW plays) or Timecode (by DAW position).", ustx, usty) :
uhov == 57 ? ulc("Reset: starts a new loudness measurement. Momentary, short-term, integrated, range, true peak and history.", ustx, usty) :
uhov == 58 || (uhov >= 70 && uhov <= 76 && udd == 1) ? ulc("History: how much time the graph shows, from 1 minute up to 5 hours (a whole feature film).", ustx, usty) :
uhov == 59 ? ulc("History: the loudness over time, now on the right. Mint band: target and tolerance. Amber and red louder, blue quieter.", ustx, usty) :
uhov == 80 ? ulc("Momentary: the loudness of the last 400 ms. The M meter next to the graph shows it too.", ustx, usty) :
uhov == 81 ? ulc("Short-term: the loudness of the last 3 seconds. The S meter next to the graph shows it too.", ustx, usty) :
uhov == 82 ? ulc("Integrated: the loudness of everything measured, with the EBU R128 gates (-70 LUFS, -10 LU).", ustx, usty) :
uhov == 83 ? ulc("Loudness range: how far the quiet and loud parts lie apart (EBU Tech 3342, 10th to 95th percentile).", ustx, usty) :
uhov == 84 ? ulc("True peak max: the highest peak, also between the samples (oversampled as in ITU-R BS.1770).", ustx, usty) :
uhov == 85 ? ulc("Timecode: the position of the DAW, 25 frames per second, counted from the project start.", ustx, usty) :
uhov == 86 ? ulc("The verdict: what the numbers mean for the chosen target.", ustx, usty) :
uhov == 87 ? ulc("Peak meters: left and right in dBFS, true peak (also between the samples). Red is above the target's limit.", ustx, usty) :
(uhov == 20 && uhb >= 0) ? (
  ufreq(#uq0, m_fc[uhb]);
  ufreq(#uq1, flo*(fhi/flo)^(uhb/unb));
  ufreq(#uq2, flo*(fhi/flo)^((uhb+1)/unb));
  m_val[uhb] ? (
    usign(#uq3, m_cor[uhb]);
    sprintf(#uq4, "%.1f", m_mon[uhb]);
    sprintf(#ust, "%s (%s to %s): %s, mono %s dB, level %d dB.%s", #uq0, #uq1, #uq2, #uq3, #uq4, floor(m_lev[uhb]+0.5),
            slider5 >= 0.5 ? " Click clears the lows." : "");
  ) : (
    sprintf(#ust, "%s (%s to %s): nothing to compare in this band.", #uq0, #uq1, #uq2);
  );
  ulc(#ust, ustx, usty);
) :
uhov == 21 ? ulc("Total: the full signal, as on a classic correlation meter. Click clears the low.", ustx, usty) :
ufrz ? ulc("Off: the display holds still. Move over it to read it, switch on to go on.", ustx, usty) :
uloud ? ulc(slider11 >= 1.5 ? "Timecode: only what plays is measured, by its position in the DAW. Playing a part again replaces it." :
            slider11 >= 0.5 ? "Playback: measures while the DAW plays and pauses when it stops." :
                              "Always: measures everything that comes in, also when the DAW stands still.", ustx, usty) :
(ofs_ok && ofs_sgn < 0) ? ( ucol(ucRED, 1); ulc("Polarity flipped: the two sides work against each other. Flip the phase of one side.", ustx, usty); ) :
(inm && blev_r <= -100 && blev_l > -100) ? ulc("No signal on the sidechain. Route the second source to inputs 3/4 of this track.", ustx, usty) :
(!inm && (blev_l > -100) != (blev_r > -100)) ? ulc("Only one side carries signal, so there is nothing to compare.", ustx, usty) :
ulc(ugon ? "Goniometer: the trace takes the color of the correlation. The bar below is the correlation of the full signal." :
    uview ? "Mono loss: 0 dB keeps its level in mono, -3 dB is two unrelated sides, deeper means the sides cancel."
           : "+1 in phase, 0 unrelated, -1 out of phase (cancels in mono). Mint and blue hold up in mono, coral and red lose level.", ustx, usty);

// ---- mouse
upress ? (
  udd ? (
    // an open list: a click picks an item or closes it, nothing below reacts
    (uhov >= 70 && uhov <= 76) ? (
      udd == 1 ? ( slider12 = uhov - 70; slider_automate(2048); ) : ( slider11 = uhov - 70; slider_automate(1024); );
    );
    udd = (uhov == 56 && udd != 2) ? 2 : (uhov == 58 && udd != 1) ? 1 : 0;
  ) : (uhov == 1 || uhov == 3) ? (
    unow = time_precise();
    uid = (uhov == 1 && (mouse_cap & 16)) ? 2 : uhov;     // Alt on Bands: selectivity
    ((mouse_cap & 4) || (uid == ulast && unow - ulastt < 0.3)) ? (
      udef(uid); udrag = 0;
    ) : (
      udrag = uid; udy = mouse_y; udacc = ufrac(uid);
    );
    ulast = uid; ulastt = unow;
  ) : uhov == 4 ? (
    (mouse_cap & 8) ? ( slider5 = slider5 >= 1.5 ? 1 : 2; ) : ( slider5 = slider5 >= 0.5 ? 0 : 1; );
    slider_automate(16); req_clr = 1;
  ) : uhov == 41 ? (
    uhelp = !uhelp;
  ) : uhov == 42 ? (
    umanual = 1;    // the plugin opens the manual in the browser
  ) : uhov == 44 ? (
    uhelp = 0;
  ) : uhov == 43 ? (
    0;              // a click inside the help panel does nothing below it
  ) : uhov == 40 ? (
    updclick = 1;   // the plugin downloads / installs / opens the release page
  ) : uhov == 10 ? (
    slider6 = ufrz ? 0 : 1; slider_automate(32);
  ) : uhov == 11 ? (
    slider4 = 0; slider_automate(8); req_clr = 1;
  ) : uhov == 12 ? (
    slider4 = 1; slider_automate(8); req_clr = 1;
  ) : uhov == 13 ? (
    slider7 = udark ? 1 : 0; slider_automate(64);
  ) : uhov == 14 ? (
    slider1 = 7; slider2 = 50; slider3 = 300; slider4 = 0; slider5 = 1; slider6 = 0; slider9 = 1;
    slider10 = 0; slider11 = 1; slider12 = 1;
    slider_automate(1|2|4|8|16|32|256|512|1024|2048); req_clr = 1; refon = 0; lreq = 1;
  ) : (uhov == 20 || uhov == 21) ? (
    req_clr = 1;
  ) : uhov == 30 ? (
    slider8 = 0; slider_automate(128);
  ) : uhov == 31 ? (
    slider8 = 1; slider_automate(128);
  ) : uhov == 35 ? (
    slider8 = 2; slider_automate(128);
  ) : uhov == 36 ? (
    slider8 = 3; slider_automate(128);
  ) : uhov == 32 ? (
    slider9 = slider9 >= 1.5 ? 0 : floor(slider9+0.5) + 1; slider_automate(256);
  ) : uhov == 33 ? (
    refon ? ( refon = 0; ) : (
      ui = 0;
      loop(unb,
        m_rfc[ui] = m_cor[ui]; m_rfm[ui] = m_mon[ui]; m_rfv[ui] = m_val[ui];
        ui += 1;
      );
      urnb = unb; refon = 1;
    );
  ) : (uhov >= 50 && uhov <= 55) ? (
    slider10 = uhov - 50; slider_automate(512);
  ) : uhov == 56 ? (
    udd = 2;
  ) : uhov == 58 ? (
    udd = 1;
  ) : uhov == 57 ? (
    lreq = 1;       // a new loudness measurement (done in @block)
  );
);
(ulb && udrag > 0) ? (
  udacc += (udy - mouse_y)/(160*usc) * ((mouse_cap & 8) ? 0.1 : 1);
  udacc = max(0, min(1, udacc));
  udy = mouse_y;
  uset(udrag, udacc);
);
!ulb ? ( udrag = 0; );
ulbp = ulb;
!uloud ? udd = 0;
// a right-click on the update note: the plug-in shows its menu
urb = mouse_cap & 2;
urb && !urbp && uhov == 40 ? updrclick = 1;
urbp = urb;
mouse_wheel != 0 ? (
  (uhov == 1 || uhov == 3) ? (
    uid = (uhov == 1 && (mouse_cap & 16)) ? 2 : uhov;
    uset(uid, ufrac(uid) + (mouse_wheel > 0 ? 1 : -1)*(uid == 1 ? 1/9 : (mouse_cap & 8) ? 0.005 : 0.03));
  );
  mouse_wheel = 0;
);
